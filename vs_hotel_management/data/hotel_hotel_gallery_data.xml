            <field name="description">
                Enjoy breathtaking panoramic views from our rooftop terrace, an ideal place to relax, socialize, or admire the surrounding city skyline.
            </field>
        </record>

        <record id="hotel_image_garden_courtyard" model="hotel.hotel.image">
