<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- ================= Hotel Gallery Images ================= -->

        <record id="hotel_image_hotel_exterior" model="hotel.hotel.image">
            <field name="name">Hotel Exterior</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="image" type="base64"
                   file="vs_hotel_management/static/src/img/hotel/gallery/hotel_exterior.jpg"/>
            <field name="description">
                Experience the elegant architecture and welcoming entrance of our hotel, designed to provide guests with a memorable first impression from the moment they arrive.
            </field>
        </record>

        <record id="hotel_image_reception_desk" model="hotel.hotel.image">
            <field name="name">Reception Desk</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="image" type="base64"
                   file="vs_hotel_management/static/src/img/hotel/gallery/reception_desk.jpg"/>
            <field name="description">
                Our professional reception team is available around the clock to assist with check-in, check-out, reservations, and guest inquiries.
            </field>
        </record>

        <record id="hotel_image_grand_lobby" model="hotel.hotel.image">
            <field name="name">Grand Lobby</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="image" type="base64"
                   file="vs_hotel_management/static/src/img/hotel/gallery/grand_lobby.jpg"/>
            <field name="description">
                Relax in our spacious grand lobby featuring elegant décor, comfortable seating, and a welcoming atmosphere for all guests.
            </field>
        </record>

        <record id="hotel_image_concierge_desk" model="hotel.hotel.image">
            <field name="name">Concierge Desk</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="image" type="base64"
                   file="vs_hotel_management/static/src/img/hotel/gallery/concierge_desk.jpg"/>
