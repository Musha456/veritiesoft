            </field>
        </record>

        <record id="hotel_image_swimming_pool" model="hotel.hotel.image">
            <field name="name">Swimming Pool</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="image" type="base64"
                   file="vs_hotel_management/static/src/img/hotel/gallery/swimming_pool.jpg"/>
            <field name="description">
                Refresh yourself in our luxurious swimming pool surrounded by comfortable loungers, offering the perfect setting for relaxation and leisure.
            </field>
        </record>

