                An elegant grand staircase showcasing timeless architectural beauty, perfect for memorable guest experiences and photographs.
            </field>
        </record>

        <record id="hotel_image_hallway_corridors" model="hotel.hotel.image">
            <field name="name">Hallway &amp; Corridors</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="image" type="base64"
                   file="vs_hotel_management/static/src/img/hotel/gallery/hallway_and_corridors.jpg"/>
            <field name="description">
                Wide, beautifully maintained corridors provide comfortable access to guest rooms while maintaining a peaceful and elegant atmosphere.
            </field>
        </record>

        <record id="hotel_image_rooftop_terrace" model="hotel.hotel.image">
            <field name="name">Rooftop Terrace</field>
            <field name="hotel_id" ref="hotel_demo"/>
