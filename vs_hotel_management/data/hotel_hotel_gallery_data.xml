                Our dedicated concierge team is ready to assist with transportation, sightseeing recommendations, restaurant reservations, and personalized guest services.
            </field>
        </record>

        <record id="hotel_image_elevator_lobby" model="hotel.hotel.image">
            <field name="name">Elevator Lobby</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="image" type="base64"
                   file="vs_hotel_management/static/src/img/hotel/gallery/elevator_lobby.jpg"/>
            <field name="description">
                Modern elevator lobby offering convenient access to all guest floors with a clean, spacious, and well-lit environment.
            </field>
        </record>

        <record id="hotel_image_staircase_lobby" model="hotel.hotel.image">
            <field name="name">Grand Staircase</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="image" type="base64"
                   file="vs_hotel_management/static/src/img/hotel/gallery/staircase_lobby.jpg"/>
