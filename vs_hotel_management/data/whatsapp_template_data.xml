<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

    <!-- 1. Task Notification Template -->
    <record id="hotel_task_notification_template"
            model="hotel.whatsapp.template">
        <field name="name">hotel_task_notification</field>
        <field name="template_key">hotel_task_notification</field>
        <field name="language">en</field>
        <field name="category">utility</field>
        <field name="task_type">both</field>
        <field name="event">both</field>
        <field name="body_text">Hotel: {{1}}
            Building: {{2}}
            Floor: {{3}}
            Room: {{4}}
            Task Type: {{5}}
            Task Detail: {{6}}
            Scheduled: {{7}}
            Current Status: {{8}}
            Instructions: {{9}}
            View Task: {{10}}
        </field>
        <field name="meta_status">draft</field>
        <field name="active" eval="True"/>
        <field name="notes">Create this template in Meta WhatsApp Manager and wait for approval before sending real
            notifications.
        </field>
    </record>

    <!-- 2. Reservation Confirmation WhatsApp Template -->
    <record id="hotel_reservation_confirmation_whatsapp_template"
            model="hotel.whatsapp.template">
        <field name="name">hotel_reservation_confirmation</field>
        <field name="template_key">hotel_reservation_confirmation</field>
        <field name="language">en</field>
        <field name="category">utility</field>
        <field name="task_type">reservation</field>
        <field name="event">confirmed</field>
        <field name="body_text">Dear {{1}}, your reservation {{2}} at {{3}} has been confirmed for check-in on {{4}} and
            check-out on {{5}}. Total Amount: {{6}}. We look forward to welcoming you!
        </field>
        <field name="meta_status">draft</field>
        <field name="active" eval="True"/>
        <field name="notes">Meta WhatsApp template for guest reservation confirmation alerts.</field>
    </record>

    <!-- 3. Reservation Cancellation WhatsApp Template -->
    <record id="hotel_reservation_cancellation_whatsapp_template"
            model="hotel.whatsapp.template">
        <field name="name">hotel_reservation_cancellation</field>
        <field name="template_key">hotel_reservation_cancellation</field>
        <field name="language">en</field>
        <field name="category">utility</field>
        <field name="task_type">reservation</field>
        <field name="event">cancelled</field>
        <field name="body_text">Dear {{1}}, your reservation {{2}} at {{3}} has been cancelled. If you have questions,
            please reach out to our front desk team.
        </field>
        <field name="meta_status">draft</field>
        <field name="active" eval="True"/>
        <field name="notes">Meta WhatsApp template for guest reservation cancellation alerts.</field>
    </record>

    <!-- 4. Reservation Checkout & Folio WhatsApp Template -->
    <record id="hotel_reservation_checkout_whatsapp_template"
            model="hotel.whatsapp.template">
        <field name="name">hotel_reservation_checkout</field>
        <field name="template_key">hotel_reservation_checkout</field>
        <field name="language">en</field>
        <field name="category">utility</field>
        <field name="task_type">reservation</field>
        <field name="event">checkout</field>
        <field name="body_text">Dear {{1}}, thank you for staying at {{2}}! Your checkout for reservation {{3}} (Folio:
            {{4}}) is complete. Total: {{5}}, Paid: {{6}}, Balance: {{7}}. Safe travels!
        </field>
        <field name="meta_status">draft</field>
        <field name="active" eval="True"/>
        <field name="notes">Meta WhatsApp template for guest checkout thank-you and folio billing summary.</field>
    </record>

    <!-- 5. Task Inspection Required WhatsApp Template -->
    <record id="hotel_task_inspection_required_whatsapp_template"
            model="hotel.whatsapp.template">
        <field name="name">hotel_task_inspection_required</field>
        <field name="template_key">hotel_task_inspection_required</field>
        <field name="language">en</field>
        <field name="category">utility</field>
        <field name="task_type">both</field>
        <field name="event">inspection_required</field>
        <field name="body_text">Inspection Required: {{1}} for Room {{2}} at {{3}} is ready for your inspection. Assigned Staff: {{4}}. View: {{5}}</field>
        <field name="meta_status">draft</field>
        <field name="active" eval="True"/>
        <field name="notes">Meta WhatsApp template to notify inspector that a task awaits inspection.</field>
    </record>

    <!-- 6. Task Inspection Passed WhatsApp Template -->
    <record id="hotel_task_inspection_passed_whatsapp_template"
            model="hotel.whatsapp.template">
        <field name="name">hotel_task_inspection_passed</field>
        <field name="template_key">hotel_task_inspection_passed</field>
        <field name="language">en</field>
        <field name="category">utility</field>
        <field name="task_type">both</field>
        <field name="event">inspection_passed</field>
        <field name="body_text">Inspection Passed: Your {{1}} for Room {{2}} has passed inspection and is now complete. Great work!</field>
        <field name="meta_status">draft</field>
        <field name="active" eval="True"/>
        <field name="notes">Meta WhatsApp template to notify staff that their task passed inspection.</field>
    </record>

    <!-- 7. Task Inspection Revision Required WhatsApp Template -->
    <record id="hotel_task_inspection_failed_whatsapp_template"
            model="hotel.whatsapp.template">
        <field name="name">hotel_task_inspection_failed</field>
        <field name="template_key">hotel_task_inspection_failed</field>
        <field name="language">en</field>
        <field name="category">utility</field>
        <field name="task_type">both</field>
        <field name="event">inspection_failed</field>
        <field name="body_text">Revision Required: Your {{1}} for Room {{2}} requires revision. Remarks: {{3}}. Please review and resubmit.</field>
        <field name="meta_status">draft</field>
        <field name="active" eval="True"/>
        <field name="notes">Meta WhatsApp template to notify staff that their task requires revision.</field>
    </record>

</odoo>
