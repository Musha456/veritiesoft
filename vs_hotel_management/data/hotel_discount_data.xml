        <!-- ========================================================= -->
        <!-- Early Booking Discount                                     -->
        <!-- ========================================================= -->

        <record id="hotel_discount_early_booking" model="hotel.discount">

            <field name="name">Early Booking Discount</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="company_id" ref="base.main_company"/>

            <field name="description">
                Save 10% when the reservation is made in advance.
            </field>

            <field name="discount_type">percentage</field>
            <field name="discount">10</field>
            <field name="maximum_discount">100.00</field>

            <field name="priority">1</field>
            <field name="website_published">1</field>
            <field name="combinable">0</field>

            <field name="minimum_nights">1</field>
            <field name="maximum_nights">0</field>

            <field name="minimum_amount">0.00</field>

            <field name="minimum_adults">1</field>
            <field name="minimum_children">0</field>

            <field name="minimum_advance_days">14</field>
            <field name="maximum_advance_days">365</field>

            <field name="coupon_required">0</field>

            <field name="monday">1</field>
            <field name="tuesday">1</field>
            <field name="wednesday">1</field>
            <field name="thursday">1</field>
            <field name="friday">1</field>
            <field name="saturday">1</field>
            <field name="sunday">1</field>

            <field name="state">active</field>

        </record>


