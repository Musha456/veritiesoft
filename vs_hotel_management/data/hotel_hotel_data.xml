            <field name="hero_image" type="bytes" file="vs_hotel_management/static/src/img/hotel/hotel_01.jpg"/>

            <field name="star_rating">5</field>

            <field name="phone">+1 555-123-4567</field>

            <field name="mobile">+1 555-987-6543</field>

