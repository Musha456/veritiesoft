            <field name="website">https://www.azurebayresort.com</field>
            <field name="street">500 Seaside Boulevard</field>
            <field name="city">Key West</field>
            <field name="state_id" ref="base.state_us_5"/>
            <field name="country_id" ref="base.us"/>
