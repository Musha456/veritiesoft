        <!-- ========================================================= -->
        <!-- Standard Room                                              -->
        <!-- ========================================================= -->

        <record id="hotel_rate_plan_standard_bar" model="hotel.rate.plan">

            <field name="name">Standard Room - Best Available Rate</field>
            <field name="hotel_id" ref="hotel_demo"/>
            <field name="company_id" ref="base.main_company"/>

            <field name="room_category_ids" eval="[
                (6, 0, [ref('hotel_room_category_standard_room')])
            ]"/>

            <field name="description">
                Standard flexible rate for Standard Rooms.
            </field>

            <field name="base_price">80.00</field>
            <field name="extra_adult_price">20.00</field>
            <field name="child_price">10.00</field>

            <field name="meal_plan">room_only</field>
            <field name="cancellation_policy">flexible</field>
            <field name="pricing_method">per_room</field>
            <field name="rate_type">standard</field>
            <field name="priority">1</field>

            <field name="minimum_nights">1</field>
            <field name="maximum_nights">30</field>
            <field name="minimum_adults">1</field>
            <field name="maximum_adults">2</field>
            <field name="minimum_children">0</field>
            <field name="maximum_children">2</field>

            <field name="minimum_advance_days">0</field>
            <field name="maximum_advance_days">365</field>

            <field name="website_published">1</field>
            <field name="state">active</field>

        </record>


