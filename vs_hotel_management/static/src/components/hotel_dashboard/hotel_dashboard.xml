<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vs_hotel_management.HotelDashboard">
        <div class="o_hotel_dashboard h-100 overflow-y-auto overflow-x-hidden p-3 p-md-4">
            
            <!-- =========================================================
                 1. TOP HEADER & ADVANCED FILTER CONTROLS
            ========================================================== -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 bg-white p-3 rounded-3 shadow-sm border">
                <div class="d-flex align-items-center gap-3">
                    <i class="fa fa-tachometer text-dark fs-3"/>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h5 class="mb-0 fw-bold text-dark">Hotel Operations Command Center</h5>
                            <span class="badge bg-light text-dark border rounded-pill px-2 py-0.5 small fw-normal d-inline-flex align-items-center gap-1">
                                <span class="o_live_dot"/> Live
                            </span>
                        </div>
                        <small class="text-muted">Real-time daily operations, live room inventory &amp; guest flows</small>
                    </div>
                </div>

                <!-- Advanced Filter Controls -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Hotel Selector -->
                    <div class="input-group input-group-sm w-auto">
                        <span class="input-group-text bg-light border-end-0 text-muted rounded-start-pill">
                            <i class="fa fa-building-o"/>
                        </span>
                        <select class="form-select form-select-sm border-start-0 rounded-end-pill fw-semibold shadow-none"
                                t-on-change="this.onHotelChange"
                                t-att-value="this.state.selectedHotelId">
                            <t t-foreach="this.state.hotels" t-as="h" t-key="h.id">
                                <option t-att-value="h.id" t-esc="h.name"/>
                            </t>
                        </select>
                    </div>

                    <!-- Duration Segmented Pill Buttons -->
                    <div class="o_duration_pill_group p-1 bg-light rounded-pill border d-inline-flex gap-1" role="group">
                        <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold transition"
                                t-att-class="this.state.selectedPreset === 'today' ? 'btn-dark shadow-sm' : 'btn-light border-0 text-muted'"
                                t-on-click="() => this.onPresetChange('today')">
                            Today
                        </button>
                        <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold transition"
                                t-att-class="this.state.selectedPreset === 'this_week' ? 'btn-dark shadow-sm' : 'btn-light border-0 text-muted'"
                                t-on-click="() => this.onPresetChange('this_week')">
                            This Week
                        </button>
                        <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold transition"
                                t-att-class="this.state.selectedPreset === 'this_month' ? 'btn-dark shadow-sm' : 'btn-light border-0 text-muted'"
                                t-on-click="() => this.onPresetChange('this_month')">
                            This Month
                        </button>
                        <button type="button" class="btn btn-sm rounded-pill px-3 py-1 fw-semibold transition"
                                t-att-class="this.state.selectedPreset === 'last_30_days' ? 'btn-dark shadow-sm' : 'btn-light border-0 text-muted'"
                                t-on-click="() => this.onPresetChange('last_30_days')">
                            30 Days
                        </button>
                    </div>

                    <!-- Date Range Search Widget -->
                    <div class="d-flex align-items-center gap-1 bg-light p-1 rounded-pill border">
                        <input type="date" class="form-control form-control-sm border-0 bg-transparent rounded-pill px-2 py-0"
                               t-att-value="this.state.customDateFrom || this.state.date_from"
                               t-on-change="this.onCustomDateFromChange"
                               title="From Date"/>
                        <span class="text-muted small">&#8594;</span>
                        <input type="date" class="form-control form-control-sm border-0 bg-transparent rounded-pill px-2 py-0"
                               t-att-value="this.state.customDateTo || this.state.date_to"
                               t-on-change="this.onCustomDateToChange"
                               title="To Date"/>
                        <button class="btn btn-sm btn-dark rounded-pill px-3 py-1 fw-semibold shadow-sm d-flex align-items-center gap-1"
                                t-on-click="this.applyDateSearch"
                                title="Apply Date Range Search">
                            <i class="fa fa-search small"/>
                            <span>Filter</span>
                        </button>
                    </div>

                    <!-- Live Refresh Button -->
                    <button class="btn btn-sm btn-outline-secondary rounded-circle shadow-none d-flex align-items-center justify-content-center"
                            style="width: 34px; height: 34px;"
                            t-on-click="this.reload"
                            title="Refresh Live Metrics">
                        <i class="fa fa-refresh text-dark" t-att-class="{'fa-spin': this.state.isLoading}"/>
                    </button>
                </div>
            </div>

            <!-- Loading Spinner -->
            <t t-if="this.state.isLoading">
                <div class="text-center py-5">
                    <div class="spinner-border text-dark" role="status">
                        <span class="visually-hidden">Loading Dashboard...</span>
                    </div>
                    <div class="mt-2 text-muted fw-semibold">Refreshing hotel operations metrics...</div>
                </div>
            </t>

            <t t-else="">
                <!-- =========================================================
                     2. DAILY OPERATIONS CORE NUMBERS (Minimalist, No Colored Boxes)
                ========================================================== -->
                <div class="row g-3 mb-4">
                    <!-- Expected Arrivals Today -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 o_stat_card cursor-pointer border rounded-3 p-3 bg-white"
                             t-on-click="this.openArrivalsToday">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="o_stat_label text-muted text-uppercase tracking-wider fw-bold small">Today's Arrivals</span>
                                <i class="fa fa-sign-in text-muted fs-4"/>
                            </div>
                            <div class="o_stat_number fs-2 fw-bold text-dark mb-1">
                                <t t-esc="this.state.queues.arrivals_today"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-between text-muted small">
                                <span>Check-ins scheduled</span>
                                <i class="fa fa-angle-right"/>
                            </div>
                        </div>
                    </div>

                    <!-- Expected Departures Today -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 o_stat_card cursor-pointer border rounded-3 p-3 bg-white"
                             t-on-click="this.openDeparturesToday">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="o_stat_label text-muted text-uppercase tracking-wider fw-bold small">Today's Departures</span>
                                <i class="fa fa-sign-out text-muted fs-4"/>
                            </div>
                            <div class="o_stat_number fs-2 fw-bold text-dark mb-1">
                                <t t-esc="this.state.queues.departures_today"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-between text-muted small">
                                <span>Check-outs scheduled</span>
                                <i class="fa fa-angle-right"/>
                            </div>
                        </div>
                    </div>

                    <!-- In-House Active Stays -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 o_stat_card cursor-pointer border rounded-3 p-3 bg-white"
                             t-on-click="this.openInHouse">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="o_stat_label text-muted text-uppercase tracking-wider fw-bold small">In-House Stays</span>
                                <i class="fa fa-bed text-muted fs-4"/>
                            </div>
                            <div class="o_stat_number fs-2 fw-bold text-dark mb-1">
                                <t t-esc="this.state.queues.in_house"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-between text-muted small">
                                <span>Occupancy: <strong class="text-dark"><t t-esc="this.state.kpis.occupancy_rate"/>%</strong></span>
                                <i class="fa fa-angle-right"/>
                            </div>
                        </div>
                    </div>

                    <!-- Available Operational Rooms -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 o_stat_card cursor-pointer border rounded-3 p-3 bg-white"
                             t-on-click="() => this.openRoomsByStatus('available')">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="o_stat_label text-muted text-uppercase tracking-wider fw-bold small">Available Rooms</span>
                                <i class="fa fa-check-circle-o text-muted fs-4"/>
                            </div>
                            <div class="o_stat_number fs-2 fw-bold text-dark mb-1">
                                <t t-esc="this.state.kpis.available_rooms"/>
                            </div>
                            <div class="d-flex align-items-center justify-content-between text-muted small">
                                <span>Ready for immediate stay</span>
                                <i class="fa fa-angle-right"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================================================
                     3. OPERATIONAL READINESS STRIP (Neutral, Modern & Actionable)
                ========================================================== -->
                <div class="card border rounded-3 shadow-sm bg-white mb-4 p-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <!-- Housekeeping & Room Status Indicators -->
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <div class="d-flex align-items-center gap-1.5 cursor-pointer py-1 px-2.5 rounded-pill bg-light border"
                                 t-on-click="() => this.openRoomsByStatus('dirty')">
                                <i class="fa fa-trash-o text-muted"/>
                                <span class="small fw-semibold text-dark">Dirty Rooms:</span>
                                <strong class="small text-dark"><t t-esc="this.state.housekeeping.dirty"/></strong>
                            </div>

                            <div class="d-flex align-items-center gap-1.5 cursor-pointer py-1 px-2.5 rounded-pill bg-light border"
                                 t-on-click="() => this.openRoomsByStatus('cleaning')">
                                <i class="fa fa-refresh text-muted"/>
                                <span class="small fw-semibold text-dark">In Cleaning:</span>
                                <strong class="small text-dark"><t t-esc="this.state.housekeeping.cleaning"/></strong>
                            </div>

                            <div class="d-flex align-items-center gap-1.5 cursor-pointer py-1 px-2.5 rounded-pill bg-light border"
                                 t-on-click="() => this.openRoomsByStatus('maintenance')">
                                <i class="fa fa-wrench text-muted"/>
                                <span class="small fw-semibold text-dark">Maintenance:</span>
                                <strong class="small text-dark"><t t-esc="this.state.housekeeping.maintenance"/></strong>
                            </div>

                            <!-- Overstay Alert (highlighted only if > 0) -->
                            <div class="d-flex align-items-center gap-1.5 cursor-pointer py-1 px-2.5 rounded-pill border"
                                 t-att-class="this.state.queues.overstay > 0 ? 'bg-danger text-white border-danger' : 'bg-light text-muted border'"
                                 t-on-click="this.openOverstays">
                                <i class="fa fa-clock-o"/>
                                <span class="small fw-semibold">Overstay Alerts:</span>
                                <strong class="small"><t t-esc="this.state.queues.overstay"/></strong>
                            </div>
                        </div>

                        <!-- Financial Snapshot -->
                        <div class="d-flex flex-wrap align-items-center gap-3 border-start ps-3">
                            <div class="small text-muted">
                                Revenue: <strong class="text-dark"><t t-esc="this.state.currencySymbol"/><t t-esc="this.state.kpis.total_revenue"/></strong>
                            </div>
                            <div class="small text-muted">
                                ADR: <strong class="text-dark"><t t-esc="this.state.currencySymbol"/><t t-esc="this.state.kpis.adr"/></strong>
                            </div>
                            <div class="small text-muted cursor-pointer" t-on-click="this.openPendingFolios">
                                Uncollected: <strong class="text-dark"><t t-esc="this.state.currencySymbol"/><t t-esc="this.state.kpis.pending_folio_balance"/></strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================================================
                     4. AVAILABLE ROOMS SECTION WITH 1-CLICK QUICK RESERVATION
                ========================================================== -->
                <div class="card border rounded-3 shadow-sm bg-white mb-4">
                    <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-check-circle text-muted fs-5"/>
                                <h6 class="mb-0 fw-bold text-dark">Available Rooms - Ready for Guest Check-in</h6>
                                <span class="badge bg-light text-dark border rounded-pill px-2.5 py-1 small">
                                    <t t-esc="this.state.availableRooms.length"/> Rooms Available
                                </span>
                            </div>
                            <small class="text-muted">Click <strong>Quick Reserve</strong> to instantly generate a new reservation with this room and open the form for guest details.</small>
                        </div>
                        <button class="btn btn-sm btn-outline-dark rounded-pill px-3" t-on-click="() => this.openRoomsByStatus('available')">
                            View All Available Rooms &#8594;
                        </button>
                    </div>

                    <div class="card-body p-3">
                        <t t-if="this.state.availableRooms.length === 0">
                            <div class="text-center py-5 text-muted">
                                <i class="fa fa-bed fa-2x mb-2 opacity-50"/>
                                <div>No rooms currently marked as available for the selected hotel property.</div>
                            </div>
                        </t>

                        <t t-else="">
                            <div class="row g-3">
                                <t t-foreach="this.state.availableRooms" t-as="room" t-key="room.id">
                                    <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                        <div class="p-3 border rounded-3 h-100 d-flex flex-column justify-content-between bg-white o_available_room_card">
                                            <div>
                                                <!-- Room Header -->
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <span class="fs-5 fw-bold text-dark">
                                                        Room <t t-esc="room.room_number"/>
                                                    </span>
                                                    <span class="badge bg-light text-dark border rounded-pill px-2 py-1 small fw-semibold">
                                                        <t t-esc="room.category_name"/>
                                                    </span>
                                                </div>

                                                <!-- Room Attributes -->
                                                <div class="text-muted small mb-1">
                                                    <i class="fa fa-building-o me-1"/>
                                                    <t t-esc="room.floor_name or 'Floor 1'"/>
                                                    <t t-if="room.building_name"> · <t t-esc="room.building_name"/></t>
                                                </div>
                                                <div class="text-muted small mb-3">
                                                    <i class="fa fa-user-o me-1"/>
                                                    <t t-esc="room.bed_type or 'King Bed'"/> · Max <t t-esc="room.max_adults"/> Guests
                                                </div>
                                            </div>

                                            <div>
                                                <!-- Rate -->
                                                <div class="d-flex align-items-baseline gap-1 mb-2 pt-2 border-top">
                                                    <span class="fs-5 fw-bold text-dark">
                                                        <t t-esc="this.state.currencySymbol"/><t t-esc="room.nightly_rate"/>
                                                    </span>
                                                    <small class="text-muted">/ night</small>
                                                </div>

                                                <!-- 1-Click Quick Reservation Action -->
                                                <button type="button"
                                                        class="btn btn-dark btn-sm rounded-pill w-100 fw-semibold d-flex align-items-center justify-content-center gap-1.5 shadow-sm o_btn_quick_book"
                                                        t-on-click="() => this.quickBookRoom(room)">
                                                    <i class="fa fa-calendar-plus-o"/>
                                                    <span>Quick Reserve</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- =========================================================
                     5. INFORMATIVE & SMART OPERATIONAL GRAPHS
                ========================================================== -->
                <div class="row g-3 mb-4">
                    <!-- 7-Day Stay Velocity & Daily Revenue Chart -->
                    <div class="col-12 col-lg-8">
                        <div class="card border rounded-3 shadow-sm h-100 bg-white">
                            <div class="card-header bg-white border-bottom py-3">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div>
                                        <h6 class="mb-0 fw-bold text-dark">7-Day Occupancy Velocity &amp; Revenue Trajectory</h6>
                                        <small class="text-muted">Bars: Occupied Rooms Count · Line: Realized Daily Room Revenue</small>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body" style="height: 310px;">
                                <canvas t-ref="this.trendChartRef"/>
                            </div>
                        </div>
                    </div>

                    <!-- Stay Channel & Booking Sources Distribution -->
                    <div class="col-12 col-lg-4">
                        <div class="card border rounded-3 shadow-sm h-100 bg-white">
                            <div class="card-header bg-white border-bottom py-3">
                                <h6 class="mb-0 fw-bold text-dark">Booking Channel Distribution</h6>
                                <small class="text-muted">Direct Online, Front Desk, OTA &amp; Phone</small>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center" style="height: 310px;">
                                <canvas t-ref="this.sourceChartRef"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================================================
                     6. DAILY LIVE QUEUES (Today's Arrivals & Today's Departures)
                ========================================================== -->
                <div class="row g-3 pb-4">
                    <!-- Today's Arrivals Queue -->
                    <div class="col-12 col-lg-6">
                        <div class="card border rounded-3 shadow-sm h-100 bg-white">
                            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-sign-in text-muted fs-5"/>
                                    <h6 class="mb-0 fw-bold text-dark">Today's Expected Arrivals (Check-in)</h6>
                                </div>
                                <button class="btn btn-sm btn-link text-dark text-decoration-none p-0 fw-semibold" t-on-click="this.openArrivalsToday">
                                    View Queue &#8594;
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="this.state.upcomingArrivals.length === 0">
                                    <div class="text-center py-4 text-muted small">No pending arrivals scheduled for today.</div>
                                </t>
                                <t t-else="">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="this.state.upcomingArrivals" t-as="item" t-key="item.id">
                                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 cursor-pointer"
                                                 t-on-click="() => this.openReservation(item.id)">
                                                <div>
                                                    <div class="fw-bold text-dark"><t t-esc="item.guest"/></div>
                                                    <small class="text-muted">
                                                        <span class="badge bg-light text-dark border me-1"><t t-esc="item.name"/></span>
                                                        Room: <strong class="text-dark"><t t-esc="item.rooms"/></strong>
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <div class="small fw-semibold text-dark"><t t-esc="item.check_in"/></div>
                                                    <span class="badge bg-light text-dark border"><t t-esc="item.state"/></span>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Today's Departures Queue -->
                    <div class="col-12 col-lg-6">
                        <div class="card border rounded-3 shadow-sm h-100 bg-white">
                            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-sign-out text-muted fs-5"/>
                                    <h6 class="mb-0 fw-bold text-dark">Today's Expected Departures (Check-out)</h6>
                                </div>
                                <button class="btn btn-sm btn-link text-dark text-decoration-none p-0 fw-semibold" t-on-click="this.openDeparturesToday">
                                    View Queue &#8594;
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="this.state.upcomingDepartures.length === 0">
                                    <div class="text-center py-4 text-muted small">No check-outs scheduled for today.</div>
                                </t>
                                <t t-else="">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="this.state.upcomingDepartures" t-as="item" t-key="item.id">
                                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 cursor-pointer"
                                                 t-on-click="() => this.openReservation(item.id)">
                                                <div>
                                                    <div class="fw-bold text-dark"><t t-esc="item.guest"/></div>
                                                    <small class="text-muted">
                                                        <span class="badge bg-light text-dark border me-1"><t t-esc="item.name"/></span>
                                                        Room: <strong class="text-dark"><t t-esc="item.rooms"/></strong>
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <div class="small fw-semibold text-muted"><t t-esc="item.check_out"/></div>
                                                    <div class="small text-dark fw-bold">
                                                        Folio: <t t-esc="this.state.currencySymbol"/><t t-esc="item.balance"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </div>
    </t>
</templates>
