<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hotel_task_inspection_wizard_form" model="ir.ui.view">
        <field name="name">hotel.task.inspection.wizard.form</field>
        <field name="model">hotel.task.inspection.wizard</field>
        <field name="arch" type="xml">
            <form string="Task Inspection Review">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="task_type" readonly="1"/> Inspection Review
                        </h2>
                    </div>

                    <group>
                        <group>
                            <field name="decision" widget="radio" options="{'horizontal': true}"/>
                            <field name="inspector_id"
                                   domain="[('is_housekeeping_manager', '=', True)] if task_type == 'housekeeping' else [('is_maintenance_manager', '=', True)]"/>
                        </group>
                    </group>

                    <group string="Inspection Feedback / Revision Remarks">
                        <field name="remarks" nolabel="1"
                               placeholder="Enter inspection feedback or mandatory revision instructions..."/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_confirm"
                            string="Confirm Decision"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
