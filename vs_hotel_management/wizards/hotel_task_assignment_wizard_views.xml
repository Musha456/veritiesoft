<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hotel_task_assignment_wizard_form" model="ir.ui.view">

        <field name="name">hotel.task.assignment.wizard.form</field>

        <field name="model">hotel.task.assignment.wizard</field>

        <field name="arch" type="xml">

            <form string="Assign Task">

                <sheet>

                    <div class="oe_title">
                        <h2>
                            <field name="task_type" readonly="1"/>
                        </h2>
                    </div>

                    <group>
                        <group>
                            <field name="room_id" readonly="1"/>
                            <field name="assigned_to" placeholder="Select employee..." required="1"/>
                            <field name="start_mode" widget="radio" options="{'horizontal': true}"/>
                        </group>

                        <group>
                            <field name="housekeeping_type" invisible="task_type != 'housekeeping'"/>
                            <field name="maintenance_type" invisible="task_type != 'maintenance'"/>
                            <field name="priority" widget="priority"/>
                            <field name="scheduled_date" invisible="start_mode != 'schedule'"
                                   required="start_mode == 'schedule'"/>
                        </group>

                    </group>

                    <group string="Instructions">
                        <field name="instruction_notes" nolabel="1"
                               placeholder="Enter instructions for the assigned employee..."/>
                    </group>

                </sheet>

                <footer>

                    <button name="action_assign"
                            string="Assign"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="view_hotel_task_completion_wizard_form"
            model="ir.ui.view">
        <field name="name">hotel.task.completion.wizard.form</field>
        <field name="model">hotel.task.completion.wizard</field>
        <field name="arch" type="xml">
            <form string="Complete Task">
                <group>
                    <field name="task_type" invisible="1"/>
                    <field name="housekeeping_id"
                           invisible="task_type != 'housekeeping'"/>
                    <field name="maintenance_id"
                           invisible="task_type != 'maintenance'"/>
                    <field name="completed_at" string="Completed At"/>
                </group>
                <footer>
                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>