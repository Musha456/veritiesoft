        <field name="model_id" ref="model_hotel_maintenance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('vs_hotel_management.group_hotel_maintenance_manager'))]"/>
    </record>

</odoo>