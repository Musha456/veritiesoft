<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ========================================================== -->
    <!-- Multi-Company Rules (Global) -->
    <!-- ========================================================== -->

    <record id="rule_hotel_hotel_company" model="ir.rule">
        <field name="name">Hotel: Multi-Company</field>
        <field name="model_id" ref="model_hotel_hotel"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_hotel_building_company" model="ir.rule">
        <field name="name">Hotel Building: Multi-Company</field>
