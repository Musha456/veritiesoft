    <!-- ========================================================== -->
    <!-- Task Assignment Rules (Housekeeping & Maintenance) -->
    <!-- ========================================================== -->

    <record id="rule_hotel_housekeeping_user" model="ir.rule">
        <field name="name">Housekeeping: Assigned or Unassigned Tasks</field>
        <field name="model_id" ref="model_hotel_housekeeping"/>
        <field name="domain_force">['|', ('assigned_to', '=', False), ('assigned_to', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('vs_hotel_management.group_hotel_housekeeping_user'))]"/>
    </record>

    <record id="rule_hotel_housekeeping_manager" model="ir.rule">
        <field name="name">Housekeeping: All Tasks</field>
        <field name="model_id" ref="model_hotel_housekeeping"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('vs_hotel_management.group_hotel_housekeeping_manager'))]"/>
    </record>

    <record id="rule_hotel_maintenance_user" model="ir.rule">
        <field name="name">Maintenance: Assigned or Unassigned Requests</field>
        <field name="model_id" ref="model_hotel_maintenance"/>
