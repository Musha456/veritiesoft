<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">

        <!-- ========================================================== -->
        <!-- Hotel Top Level Category -->
        <!-- ========================================================== -->
        <record model="ir.module.category" id="module_category_hotel">
            <field name="name">Hotel Management</field>
            <field name="sequence">1</field>
        </record>

        <!-- ========================================================== -->
        <!-- Hotel Settings -->
        <!-- ========================================================== -->
        <record model="ir.module.category" id="module_category_hotel_management">
            <field name="name">Settings</field>
            <field name="parent_id" ref="vs_hotel_management.module_category_hotel"/>
            <field name="sequence">0</field>
        </record>

        <record id="group_hotel_setting_manager" model="res.groups">
            <field name="name">Settings Manager</field>
            <field name="category_id" ref="module_category_hotel_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- ========================================================== -->
        <!-- Reservation -->
        <!-- ========================================================== -->
        <record model="ir.module.category" id="module_category_hotel_reservation">
            <field name="name">Reservation</field>
            <field name="parent_id" ref="vs_hotel_management.module_category_hotel"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_hotel_reservation_user" model="res.groups">
            <field name="name">Reservation User</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_reservation"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_hotel_reservation_manager" model="res.groups">
            <field name="name">Reservation Manager</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_reservation"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_reservation_user'))]"/>
        </record>

        <!-- ========================================================== -->
        <!-- Room -->
        <!-- ========================================================== -->
        <record model="ir.module.category" id="module_category_hotel_room">
            <field name="name">Room</field>
            <field name="parent_id" ref="vs_hotel_management.module_category_hotel"/>
            <field name="sequence">11</field>
        </record>

        <record id="group_hotel_room_user" model="res.groups">
            <field name="name">Room User</field>
            <field name="comment">The user will have access of read and write permission</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_room"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Group Room Manager (Hotel General Manager) -->
        <record id="group_hotel_room_manager" model="res.groups">
            <field name="name">Room Manager (Hotel Manager)</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_room"/>
            <field name="implied_ids" eval="[
                (4, ref('group_hotel_room_user')),
                (4, ref('group_hotel_reservation_manager')),
                (4, ref('group_hotel_setting_manager'))
            ]"/>
        </record>

        <!-- ========================================================== -->
        <!-- Housekeeping -->
        <!-- ========================================================== -->
        <record model="ir.module.category" id="module_category_hotel_housekeeping">
            <field name="name">Housekeeping</field>
            <field name="parent_id" ref="vs_hotel_management.module_category_hotel"/>
            <field name="sequence">12</field>
        </record>

        <record id="group_hotel_housekeeping_user" model="res.groups">
            <field name="name">Housekeeping User</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_housekeeping"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_hotel_housekeeping_manager" model="res.groups">
            <field name="name">Housekeeping Manager</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_housekeeping"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_housekeeping_user'))]"/>
        </record>

        <!-- ========================================================== -->
        <!-- Maintenance -->
        <!-- ========================================================== -->
        <record model="ir.module.category" id="module_category_hotel_maintenance">
            <field name="name">Maintenance</field>
            <field name="parent_id" ref="vs_hotel_management.module_category_hotel"/>
            <field name="sequence">13</field>
        </record>

        <record id="group_hotel_maintenance_user" model="res.groups">
            <field name="name">Maintenance User</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_hotel_maintenance_manager" model="res.groups">
            <field name="name">Maintenance Manager</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_maintenance"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_maintenance_user'))]"/>
        </record>

        <!-- ========================================================== -->
        <!-- Billing -->
        <!-- ========================================================== -->
        <record model="ir.module.category" id="module_category_hotel_billing">
            <field name="name">Billing</field>
            <field name="parent_id" ref="vs_hotel_management.module_category_hotel"/>
            <field name="sequence">14</field>
        </record>

        <record id="group_hotel_billing_user" model="res.groups">
            <field name="name">Billing User</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_billing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_hotel_billing_manager" model="res.groups">
            <field name="name">Billing Manager</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_billing"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_billing_user'))]"/>
        </record>

        <!-- ========================================================== -->
        <!-- Reporting -->
        <!-- ========================================================== -->
        <record model="ir.module.category" id="module_category_hotel_reporting">
            <field name="name">Reporting</field>
            <field name="parent_id" ref="vs_hotel_management.module_category_hotel"/>
            <field name="sequence">15</field>
        </record>

        <record id="group_hotel_reporting_user" model="res.groups">
            <field name="name">Reporting User</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_reporting"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_hotel_reporting_manager" model="res.groups">
            <field name="name">Reporting Manager</field>
            <field name="category_id" ref="vs_hotel_management.module_category_hotel_reporting"/>
            <field name="implied_ids" eval="[(4, ref('group_hotel_reporting_user'))]"/>
        </record>

        <!-- Room Manager inherits Housekeeping, Maintenance, Billing & Reporting Managers -->
        <record id="group_hotel_room_manager" model="res.groups">
            <field name="implied_ids" eval="[
                (4, ref('group_hotel_housekeeping_manager')),
                (4, ref('group_hotel_maintenance_manager')),
                (4, ref('group_hotel_billing_manager')),
                (4, ref('group_hotel_reporting_manager'))
            ]"/>
        </record>

    </data>
</odoo>