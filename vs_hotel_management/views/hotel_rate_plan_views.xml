<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_hotel_rate_plan_tree" model="ir.ui.view">
        <field name="name">hotel.rate.plan.tree</field>
        <field name="model">hotel.rate.plan</field>
        <field name="arch" type="xml">
            <list string="Rate Plan" default_order="sequence,name"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'expired'"
                  decoration-muted="state == 'archived'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="hotel_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_rate_plan_search" model="ir.ui.view">
        <field name="name">hotel.rate.plan.search</field>
        <field name="model">hotel.rate.plan</field>
        <field name="arch" type="xml">
            <search string="Search Rate Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="hotel_id"/>
                <field name="room_category_ids"/>
                <separator/>
                <filter
                        name="active"
                        string="Active"
                        domain="[('active','=',True)]"/>

                <filter
                        name="archived"
                        string="Archived"
                        domain="[('active','=',False)]"/>

                <separator/>
                <filter
                        name="draft"
                        string="Draft"
                        domain="[('state','=','draft')]"/>

                <filter
                        name="active_state"
                        string="Active"
                        domain="[('state','=','active')]"/>

                <filter
                        name="expired_state"
                        string="Expired"
                        domain="[('state','=','expired')]"/>

                <filter
                        name="archived_state"
                        string="Archived"
                        domain="[('state','=','archived')]"/>

                <separator/>

                <filter
                        name="room_only"
                        string="Room Only"
                        domain="[('meal_plan','=','room_only')]"/>

                <filter
                        name="breakfast"
                        string="Breakfast"
                        domain="[('meal_plan','=','breakfast')]"/>

                <filter
                        name="half_board"
                        string="Half Board"
                        domain="[('meal_plan','=','half_board')]"/>

                <filter
                        name="full_board"
                        string="Full Board"
                        domain="[('meal_plan','=','full_board')]"/>

                <filter
                        name="all_inclusive"
                        string="All Inclusive"
                        domain="[('meal_plan','=','all_inclusive')]"/>

                <group expand="0" string="Group By">

                    <filter
                            name="hotel"
                            string="Hotel"
                            context="{'group_by':'hotel_id'}"/>

                    <filter
                            name="meal_plan"
                            string="Meal Plan"
                            context="{'group_by':'meal_plan'}"/>

                    <filter
                            name="company"
                            string="Company"
                            context="{'group_by':'company_id'}"
                            groups="base.group_multi_company"/>

                </group>

            </search>

        </field>

    </record>

    <record id="view_hotel_rate_plan_form" model="ir.ui.view">
        <field name="name">hotel.rate.plan.form</field>
        <field name="model">hotel.rate.plan</field>
        <field name="arch" type="xml">
            <form string="Rate Plan">
                <header>

                    <button
                            name="action_activate"
                            type="object"
                            string="Activate"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button
                            name="action_expire"
                            type="object"
                            string="Expire"
                            invisible="state != 'active'"/>
                    <button
                            name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            invisible="state != 'expired'"/>
                    <field
                            name="state"
                            widget="statusbar"
                            statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title mb24">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Standard Rate"/>
                        </h1>
                        <div class="text-muted mt-1">
                            <strong class="me-1">Code:</strong>
                            <field name="code"
                                   class="oe_inline"
                                   readonly="1"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="General">

                            <group>
                                <group>

                                    <field name="hotel_id"/>

                                    <field name="room_category_ids"
                                           widget="many2many_tags"/>

                                    <field name="rate_type"/>

                                    <field name="pricing_method"/>

                                </group>

                                <group>

                                    <field name="meal_plan"/>

                                    <field name="cancellation_policy"/>

                                    <field name="priority" widget="priority"/>

                                    <field name="is_default"/>

                                </group>

                            </group>

                        </page>
                        <page string="Pricing">

                            <group>

                                <group string="Room Charges">

                                    <field name="base_price"
                                           widget="monetary"/>

                                    <field name="extra_adult_price"
                                           widget="monetary"/>

                                    <field name="child_price"
                                           widget="monetary"/>

                                </group>

                                <group string="Availability">

                                    <field name="website_published" widget="boolean_toggle"/>

                                    <field name="currency_id"
                                           readonly="1"/>

                                </group>

                            </group>

                        </page>
                        <page string="Availability">

                            <group string="Validity" col="6">

                                <group colspan="1">

                                    <field name="date_start"/>

                                </group>

                                <group colspan="3">

                                    <field name="date_end"/>

                                </group>

                            </group>

                            <group string="Availability">

                                <field name="website_published" widget="boolean_toggle"/>

                            </group>

                            <group string="Available Days" col="2">

                                <label for="monday"/>
                                <field name="monday" widget="boolean_toggle" nolabel="1"/>

                                <label for="tuesday"/>
                                <field name="tuesday" widget="boolean_toggle" nolabel="1"/>

                                <label for="wednesday"/>
                                <field name="wednesday" widget="boolean_toggle" nolabel="1"/>

                                <label for="thursday"/>
                                <field name="thursday" widget="boolean_toggle" nolabel="1"/>

                                <label for="friday"/>
                                <field name="friday" widget="boolean_toggle" nolabel="1"/>

                                <label for="saturday"/>
                                <field name="saturday" widget="boolean_toggle" nolabel="1"/>

                                <label for="sunday"/>
                                <field name="sunday" widget="boolean_toggle" nolabel="1"/>

                            </group>
                        </page>
                        <page string="Booking Rules">
                            <!-- Stay Rules -->
                            <group string="Stay Rules" col="4">
                                <group colspan="1">
                                    <field name="minimum_nights"/>
                                </group>
                                <group colspan="1">
                                    <field name="maximum_nights"/>
                                </group>
                                <group colspan="1">
                                    <field name="priority" widget="priority"/>
                                </group>
                                <group colspan="1">
                                    <field name="is_default" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <!-- Guest Occupancy -->
                            <group string="Guest Occupancy" col="4">
                                <group colspan="1">
                                    <field name="minimum_adults"/>
                                </group>
                                <group colspan="1">
                                    <field name="maximum_adults"/>
                                </group>
                                <group colspan="1">
                                    <field name="minimum_children"/>
                                </group>
                                <group colspan="1">
                                    <field name="maximum_children"/>
                                </group>
                            </group>
                            <!-- Advance Booking -->
                            <group string="Advance Booking" col="4">
                                <group colspan="1">
                                    <field name="minimum_advance_days"/>
                                </group>
                                <group colspan="3">
                                    <field name="maximum_advance_days"/>
                                </group>
                            </group>
                        </page>
                        <page string="Statistics"
                              invisible="not id">
                            <group string="Reservations">
                                <group>
                                    <field name="reservation_count"
                                           readonly="1"/>
                                </group>
                                <!--                                <group>-->
                                <!--                                    <field name="active_reservation_count"-->
                                <!--                                           readonly="1"/>-->
                                <!--                                </group>-->
                            </group>
                            <group string="Revenue">
                                <group>
                                    <field name="revenue"
                                           widget="monetary"
                                           readonly="1"/>
                                </group>
                                <group>
                                    <field name="average_booking_value"
                                           widget="monetary"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Describe the rate plan, inclusions, exclusions, and booking conditions..."/>
                        </page>
                        <page string="Internal Notes">
                            <field name="internal_note"
                                   nolabel="1"
                                   placeholder="Internal notes visible only to hotel staff..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="action_hotel_rate_plan" model="ir.actions.act_window">
        <field name="name">Hotel Rate Plan</field>
        <field name="res_model">hotel.rate.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hotel_rate_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first hotel rate plan
            </p>
        </field>
    </record>


</odoo>