<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_users_form_hotel_inherit" model="ir.ui.view">
        <field name="name">res.users.form.hotel.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_view_user_housekeeping_tasks"
                        type="object"
                        class="oe_stat_button"
                        icon="check_box"
                        groups="vs_hotel_management.group_hotel_housekeeping_user,vs_hotel_management.group_hotel_manager">
                    <field name="housekeeping_task_count"
                           widget="statinfo"
                           string="Housekeeping"/>
                </button>

                <button name="action_view_user_maintenance_tasks"
                        type="object"
                        class="oe_stat_button"
                        icon="build"
                        groups="vs_hotel_management.group_hotel_maintenance_user,vs_hotel_management.group_hotel_manager">
                    <field name="maintenance_task_count"
                           widget="statinfo"
                           string="Maintenance"/>
                </button>

            </xpath>

        </field>
    </record>
</odoo>
