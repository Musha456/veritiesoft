<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_hotel_bed_type_tree" model="ir.ui.view">
        <field name="name">hotel.bed.type.tree</field>
        <field name="model">hotel.bed.type</field>
        <field name="arch" type="xml">
            <list string="Bed Types" default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [32, 32]}"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_bed_type_search" model="ir.ui.view">
        <field name="name">hotel.bed.type.search</field>
        <field name="model">hotel.bed.type</field>
        <field name="arch" type="xml">

            <search string="Search Bed Types">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <group string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by':'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>

        </field>
    </record>

    <record id="view_hotel_bed_type_form" model="ir.ui.view">
        <field name="name">hotel.bed.type.form</field>
        <field name="model">hotel.bed.type</field>
        <field name="arch" type="xml">
            <form string="Bed Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_room_categories" type="object" class="oe_stat_button"
                                invisible="not room_category_count" icon="fa-tags">
                            <field name="room_category_count" widget="statinfo" string="Room Category"/>
                        </button>

                    </div>

                    <div class="oe_title mb24">
                        <h1>
                            <field name="name" placeholder="e.g. Double Bed"/>
                        </h1>
                    </div>

                    <group>

                        <group string="General Info">

                            <group>
                                <field name="code" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>

                            <group>
                                <field name="active" widget="boolean_toggle"/>
                            </group>

                        </group>

                        <group>
                            <field name="image" widget="image" nolabel="1" options="{'size': [256, 256]}"/>
                        </group>

                    </group>

                    <group string="Description">
                        <field name="description" placeholder="Add internal notes..." nolabel="1"/>
                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <record id="action_hotel_bed_type" model="ir.actions.act_window">
        <field name="name">Bed Types</field>
        <field name="res_model">hotel.bed.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hotel_bed_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Bed type
            </p>
        </field>
    </record>


</odoo>