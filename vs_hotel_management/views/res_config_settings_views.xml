<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_hotel" model="ir.ui.view">
            <field name="name">res.config.settings.hotel.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//form" position="inside">

                    <app data-string="Hotel Management" string="Hotel Management" name="vs_hotel_management"
                         groups="vs_hotel_management.group_hotel_room_manager"
                         logo="/vs_hotel_management/static/description/icon.png">

                        <block title="General">

                            <setting string="Default Check-in Time">

                                <field name="checkin_time_default" widget="float_time"/>

                            </setting>

                            <setting string="Default Check-out Time">

                                <field name="checkout_time_default" widget="float_time"/>

                            </setting>

                        </block>

                        <block title="Room Automation">

                            <setting string="Mark Room Dirty on Check-out">

                                <field name="mark_room_dirty_on_checkout"/>

                            </setting>

                            <setting id="hotel_auto_available_room"
                                     string="Make Room Available After Cleaning">
                                <field name="hotel_auto_available_room"/>
                            </setting>

                        </block>

                        <block title="Reservations">

                            <setting string="Allow Overbooking">

                                <field name="allow_overbooking"/>

                            </setting>

                            <setting string="Allow Early Check-in">

                                <field name="allow_early_checkin"/>

                            </setting>

                            <setting string="Allow Early Checkout"
                                     help="Allow checkout before the scheduled checkout time by default.">

                                <field name="allow_early_checkout"/>

                            </setting>


                            <setting id="hotel_auto_confirm_reservation"
                                     string="Auto-confirm Reservations"
                                     help="Automatically confirm new hotel reservations.">
                                <field name="hotel_auto_confirm_reservation"/>
                            </setting>

                            <setting id="hotel_auto_create_invoice"
                                     string="Auto-create Invoice"
                                     help="Automatically create the customer invoice from the guest folio.">
                                <field name="hotel_auto_create_invoice"/>
                            </setting>

                            <setting id="hotel_require_payment_before_checkout"
                                     string="Require Payment Before Checkout">
                                <field name="hotel_require_payment_before_checkout"/>
                            </setting>

                            <setting id="hotel_auto_close_folio_after_payment"
                                     string="Auto-close Folio After Payment">
                                <field name="hotel_auto_close_folio_after_payment"/>
                            </setting>

                            <setting id="hotel_require_guest"
                                     string="Require Guest">
                                <field name="hotel_require_guest"/>
                            </setting>

                            <setting id="hotel_minimum_stay"
                                     string="Minimum Stay"
                                     help="Minimum number of nights allowed for a reservation.">
                                <field name="hotel_minimum_stay"/>
                            </setting>

                            <setting id="hotel_maximum_stay"
                                     string="Maximum Stay"
                                     help="Maximum number of nights allowed for a reservation.">
                                <field name="hotel_maximum_stay"/>
                            </setting>

                            <setting id="setting_default_hotel" string="Default Hotel">
                                <field name="use_default_hotel"/>

                                <div class="content-group" invisible="not use_default_hotel">
                                    <field name="configured_hotel_id"
                                           required="use_default_hotel"/>
                                </div>
                            </setting>

                            <setting id="setting_default_building"
                                     string="Default Building"
                                     invisible="not use_default_hotel">
                                <field name="use_default_building"
                                       invisible="not use_default_hotel"/>

                                <div class="content-group"
                                     invisible="not use_default_hotel or not use_default_building">
                                    <field name="configured_building_id"
                                           required="use_default_building"
                                           domain="[('hotel_id', '=', configured_hotel_id)]"/>
                                </div>
                            </setting>

                            <setting id="setting_default_floor"
                                     string="Default Floor"
                                     invisible="not use_default_hotel or not use_default_building">
                                <field name="use_default_floor"
                                       invisible="not use_default_hotel or not use_default_building"/>

                                <div class="content-group"
                                     invisible="not use_default_hotel or not use_default_building or not use_default_floor">
                                    <field name="configured_floor_id"
                                           required="use_default_floor"/>
                                </div>
                            </setting>

                            <!--                            <setting-->
                            <!--                                    id="allow_room_add_reserved_setting"-->
                            <!--                                    string="Allow Adding Rooms to Reserved Reservations"-->
                            <!--                                    help="Allow users to add room lines to reservations in the Reserved state. Newly added lines will receive room bookings."-->
                            <!--                            >-->
                            <!--                                <field name="allow_room_add_reserved"/>-->
                            <!--                            </setting>-->

                        </block>

                        <block title="Housekeeping and Maintenance">
                            <setting id="auto_start_housekeeping"
                                     string="Automatically Start Housekeeping"
                                     help="Automatically start scheduled housekeeping tasks when their scheduled time is reached.">
                                <field name="auto_start_housekeeping"/>
                            </setting>

                            <setting id="auto_start_maintenance"
                                     string="Automatically Start Maintenance"
                                     help="Automatically start scheduled maintenance tasks when their scheduled time is reached.">
                                <field name="auto_start_maintenance"/>
                            </setting>
                        </block>

                        <block title="Notifications">

                            <setting string="Email Notifications"
                                     help="Control email notifications for housekeeping and maintenance tasks.">
                                <div class="content-group">
                                    <field name="email_housekeeping_assigned"/>
                                    <field name="email_housekeeping_cancelled"/>
                                    <field name="email_maintenance_assigned"/>
                                    <field name="email_maintenance_cancelled"/>
                                </div>
                            </setting>

                            <setting string="WhatsApp Notifications"
                                     help="Send task notifications through Meta WhatsApp Business Cloud API.">
                                <field name="whatsapp_notifications_enabled"/>
                                <div class="content-group"
                                     invisible="not whatsapp_notifications_enabled">
                                    <group>
                                        <field name="whatsapp_housekeeping_assigned"/>
                                        <field name="whatsapp_housekeeping_cancelled"/>
                                        <field name="whatsapp_maintenance_assigned"/>
                                        <field name="whatsapp_maintenance_cancelled"/>
                                    </group>
                                    <group string="Meta API Configuration">
                                        <field name="whatsapp_access_token" password="True"/>
                                        <field name="whatsapp_phone_number_id"/>
                                        <field name="whatsapp_business_account_id"/>
                                        <field name="whatsapp_api_version"/>
                                        <field name="whatsapp_template_name"/>
                                        <field name="whatsapp_template_language"/>
                                    </group>

                                    <button name="action_test_whatsapp_connection"
                                            type="object"
                                            string="Test Connection"
                                            class="btn-primary"
                                            icon="fa-plug"/>
                                </div>
                            </setting>

                        </block>


                    </app>

                </xpath>

            </field>

        </record>

        <record id="action_hotel_config_settings" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'vs_hotel_management', 'bin_size': False}</field>
        </record>

    </data>
</odoo>