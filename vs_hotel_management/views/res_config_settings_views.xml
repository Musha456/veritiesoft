<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_hotel" model="ir.ui.view">
            <field name="name">res.config.settings.hotel.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//form" position="inside">

                    <app data-string="Hotel Management" string="Hotel Management" name="vs_hotel_management"
                         groups="vs_hotel_management.group_hotel_room_manager"
                         logo="/vs_hotel_management/static/description/icon.png">

                        <!-- ================================================= -->
                        <!-- 1. GENERAL & TIMING                               -->
                        <!-- ================================================= -->
                        <block title="General &amp; Timing Settings" id="block_general_timing">

                            <setting id="setting_checkin_time"
                                     string="Default Check-in Time"
                                     help="Standard default check-in time (e.g. 14.0 for 2:00 PM). Used when creating new reservations.">
                                <field name="checkin_time_default" widget="float_time"/>
                            </setting>

                            <setting id="setting_checkout_time"
                                     string="Default Check-out Time"
                                     help="Standard default check-out time (e.g. 12.0 for 12:00 PM noon). Used when creating new reservations.">
                                <field name="checkout_time_default" widget="float_time"/>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 2. DEFAULT PROPERTY HIERARCHY                     -->
                        <!-- ================================================= -->
                        <block title="Default Property &amp; Location Hierarchy" id="block_default_hotel">

                            <setting id="setting_default_hotel"
                                     string="Default Hotel"
                                     help="Pre-populate a default hotel on newly created reservations and rooms.">
                                <field name="use_default_hotel"/>
                                <div class="content-group" invisible="not use_default_hotel">
                                    <div class="mt8">
                                        <field name="configured_hotel_id"
                                               required="use_default_hotel"
                                               placeholder="Select Default Hotel..."/>
                                    </div>
                                </div>
                            </setting>

                            <setting id="setting_default_building"
                                     string="Default Building"
                                     help="Pre-populate a default building belonging to the selected hotel."
                                     invisible="not use_default_hotel">
                                <field name="use_default_building"/>
                                <div class="content-group"
                                     invisible="not use_default_hotel or not use_default_building">
                                    <div class="mt8">
                                        <field name="configured_building_id"
                                               required="use_default_building"
                                               domain="[('hotel_id', '=', configured_hotel_id)]"
                                               placeholder="Select Default Building..."/>
                                    </div>
                                </div>
                            </setting>

                            <setting id="setting_default_floor"
                                     string="Default Floor"
                                     help="Pre-populate a default floor belonging to the selected building."
                                     invisible="not use_default_hotel or not use_default_building">
                                <field name="use_default_floor"/>
                                <div class="content-group"
                                     invisible="not use_default_hotel or not use_default_building or not use_default_floor">
                                    <div class="mt8">
                                        <field name="configured_floor_id"
                                               required="use_default_floor"
                                               domain="[('building_id', '=', configured_building_id)]"
                                               placeholder="Select Default Floor..."/>
                                    </div>
                                </div>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 3. RESERVATION RULES & STAY LIMITS                -->
                        <!-- ================================================= -->
                        <block title="Reservation Policies &amp; Stay Rules" id="block_reservation_rules">

                            <setting id="hotel_minimum_stay_setting"
                                     string="Minimum Stay (Nights)"
                                     help="Minimum number of nights required for reservations.">
                                <field name="hotel_minimum_stay"/>
                            </setting>

                            <setting id="hotel_maximum_stay_setting"
                                     string="Maximum Stay (Nights)"
                                     help="Maximum number of nights allowed for reservations.">
                                <field name="hotel_maximum_stay"/>
                            </setting>

                            <setting id="hotel_require_guest_setting"
                                     string="Require Guest Contact"
                                     help="Require a valid guest partner before confirming a reservation.">
                                <field name="hotel_require_guest"/>
                            </setting>

                            <setting id="hotel_require_rate_plan_setting"
                                     string="Require Rate Plan"
                                     help="Require a rate plan to be specified on each reservation line.">
                                <field name="hotel_require_rate_plan"/>
                            </setting>

                            <setting id="allow_overbooking_setting"
                                     string="Allow Overbooking"
                                     help="Permit reservations to exceed room availability without throwing blocking errors.">
                                <field name="allow_overbooking"/>
                            </setting>

                            <setting id="allow_early_checkin_setting"
                                     string="Allow Early Check-in"
                                     help="Permit front desk staff to check in guests before the scheduled check-in time.">
                                <field name="allow_early_checkin"/>
                            </setting>

                            <setting id="allow_early_checkout_setting"
                                     string="Allow Early Checkout"
                                     help="Permit guests to check out before the scheduled check-out time without restrictions.">
                                <field name="allow_early_checkout"/>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 4. RESERVATION & BILLING AUTOMATION               -->
                        <!-- ================================================= -->
                        <block title="Reservation &amp; Billing Automation" id="block_reservation_automation">

                            <setting id="hotel_auto_confirm_reservation_setting"
                                     string="Auto-confirm Reservations"
                                     help="Automatically confirm new hotel reservations upon creation.">
                                <field name="hotel_auto_confirm_reservation"/>
                            </setting>

                            <setting id="hotel_auto_create_invoice_setting"
                                     string="Auto-create Invoice on Checkout"
                                     help="Automatically generate customer invoice from the guest folio upon checkout.">
                                <field name="hotel_auto_create_invoice"/>
                            </setting>

                            <setting id="hotel_require_payment_before_checkout_setting"
                                     string="Require Payment Before Checkout"
                                     help="Enforce full payment and zero outstanding balance on the guest folio prior to checkout.">
                                <field name="hotel_require_payment_before_checkout"/>
                            </setting>

                            <setting id="hotel_auto_close_folio_after_payment_setting"
                                     string="Auto-close Folio After Payment"
                                     help="Automatically transition guest folio status to Closed once all payments are received.">
                                <field name="hotel_auto_close_folio_after_payment"/>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 5. ROOM & TASK AUTOMATION                         -->
                        <!-- ================================================= -->
                        <block title="Room, Housekeeping &amp; Maintenance Automation" id="block_room_task_automation">

                            <setting id="mark_room_dirty_on_checkout_setting"
                                     string="Mark Room Dirty on Checkout"
                                     help="Automatically mark room status as Dirty and schedule cleaning when a guest checks out.">
                                 <field name="mark_room_dirty_on_checkout"/>
                            </setting>

                            <setting id="auto_start_housekeeping_setting"
                                     string="Auto-start Scheduled Housekeeping"
                                     help="Automatically transition scheduled housekeeping tasks to In Progress when scheduled time arrives."
                                     invisible="not mark_room_dirty_on_checkout">
                                <field name="auto_start_housekeeping"/>
                            </setting>

                            <setting id="setting_housekeeping_assigned_user"
                                     string="Checkout Housekeeper"
                                     help="Housekeeping staff member automatically assigned to checkout cleaning tasks."
                                     invisible="not mark_room_dirty_on_checkout or not auto_start_housekeeping">
                                <field name="housekeeping_assigned_user_id"
                                       required="mark_room_dirty_on_checkout and auto_start_housekeeping"
                                       placeholder="Select Housekeeping User..."/>
                            </setting>

                            <setting id="auto_start_maintenance_setting"
                                     string="Auto-start Scheduled Maintenance"
                                     help="Automatically transition scheduled maintenance tasks to In Progress when scheduled time arrives."
                                     invisible="not mark_room_dirty_on_checkout">
                                <field name="auto_start_maintenance"/>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 6. RESERVATION NOTIFICATIONS                      -->
                        <!-- ================================================= -->
                        <block title="Reservation Notifications" id="block_reservation_notifications">

                            <setting id="setting_reservation_email_notifications"
                                     string="Email Notifications"
                                     help="Automatically send email confirmations, cancellations, checkouts, and no-shows to guests.">
                                <field name="notify_reservation_email"/>
                            </setting>

                            <setting id="setting_reservation_whatsapp_notifications"
                                     string="WhatsApp Notifications"
                                     help="Automatically send WhatsApp updates for reservation lifecycle events to guests.">
                                <field name="notify_reservation_whatsapp"/>
                            </setting>

                            <setting id="setting_reservation_sms_notifications"
                                     string="SMS Notifications"
                                     help="Automatically send SMS alerts for reservation lifecycle events to guests.">
                                <field name="notify_reservation_sms"/>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 7. HOUSEKEEPING TASK NOTIFICATIONS                -->
                        <!-- ================================================= -->
                        <block title="Housekeeping Task Notifications" id="block_housekeeping_notifications">

                            <setting id="setting_housekeeping_email"
                                     string="Email Notifications"
                                     help="Send email alerts to assigned housekeepers upon task assignment and cancellation.">
                                <field name="notify_housekeeping_email"/>
                            </setting>

                            <setting id="setting_housekeeping_whatsapp"
                                     string="WhatsApp Notifications"
                                     help="Send Meta WhatsApp messages to assigned housekeepers upon task assignment and cancellation.">
                                <field name="notify_housekeeping_whatsapp"/>
                            </setting>

                            <setting id="setting_housekeeping_sms"
                                     string="SMS Notifications"
                                     help="Send SMS alerts to assigned housekeepers upon task assignment and cancellation.">
                                <field name="notify_housekeeping_sms"/>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 8. MAINTENANCE TASK NOTIFICATIONS                 -->
                        <!-- ================================================= -->
                        <block title="Maintenance Task Notifications" id="block_maintenance_notifications">

                            <setting id="setting_maintenance_email"
                                     string="Email Notifications"
                                     help="Send email alerts to technicians upon maintenance task assignment and cancellation.">
                                <field name="notify_maintenance_email"/>
                            </setting>

                            <setting id="setting_maintenance_whatsapp"
                                     string="WhatsApp Notifications"
                                     help="Send Meta WhatsApp messages to technicians upon task assignment and cancellation.">
                                <field name="notify_maintenance_whatsapp"/>
                            </setting>

                            <setting id="setting_maintenance_sms"
                                     string="SMS Notifications"
                                     help="Send SMS alerts to technicians upon task assignment and cancellation.">
                                <field name="notify_maintenance_sms"/>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 9. TRAVEL AGENTS & PRICING DEFAULTS               -->
                        <!-- ================================================= -->
                        <block title="Travel Agents &amp; Pricing Defaults" id="block_travel_agent_pricing">

                            <setting id="setting_travel_agent_commission"
                                     string="Travel Agent Commission"
                                     help="Enable travel agent commission calculation and tracking on reservations.">
                                <field name="enable_travel_agent_commission"/>
                                <div class="content-group mt-2" invisible="not enable_travel_agent_commission">
                                    <div class="d-flex align-items-center gap-2">
                                        <label for="hotel_default_agent_commission_percentage" string="Default Commission (%)" class="fw-bold"/>
                                        <field name="hotel_default_agent_commission_percentage" class="oe_inline"/>
                                    </div>
                                </div>
                            </setting>

                            <setting id="setting_default_rate_plan"
                                     string="Default Rate Plan"
                                     help="Default rate plan pre-selected when booking rooms.">
                                <div class="content-group">
                                    <field name="hotel_default_rate_plan_id" class="w-100"/>
                                </div>
                            </setting>

                            <setting id="setting_default_room_discount"
                                     string="Default Room Discount"
                                     help="Default discount pre-selected for room bookings.">
                                <div class="content-group">
                                    <field name="hotel_default_room_discount_id" class="w-100"/>
                                </div>
                            </setting>

                            <setting id="setting_default_service_discount"
                                     string="Default Service Discount"
                                     help="Default discount pre-selected for hotel service lines.">
                                <div class="content-group">
                                    <field name="hotel_default_service_discount_id" class="w-100"/>
                                </div>
                            </setting>

                        </block>

                        <!-- ================================================= -->
                        <!-- 10. COMPANY WHATSAPP CLOUD API INTEGRATION        -->
                        <!-- ================================================= -->
                        <block title="Company WhatsApp Integration (Meta Cloud API)" id="block_whatsapp_credentials">

                            <setting id="setting_whatsapp_credentials"
                                     string="Meta Cloud API Credentials"
                                     help="Connect your WhatsApp Business Account using Meta Developer credentials.">
                                <div class="content-group w-100">
                                    <div class="mb-2">
                                        <label for="whatsapp_access_token" class="fw-bold d-block mb-1" string="Meta Access Token"/>
                                        <field name="whatsapp_access_token" password="True" class="w-100" placeholder="EAAB..."/>
                                    </div>
                                    <div class="mb-2">
                                        <label for="whatsapp_phone_number_id" class="fw-bold d-block mb-1" string="Phone Number ID"/>
                                        <field name="whatsapp_phone_number_id" class="w-100" placeholder="e.g. 1223822660794927"/>
                                    </div>
                                    <div class="mb-2">
                                        <label for="whatsapp_business_account_id" class="fw-bold d-block mb-1" string="WhatsApp Business Account ID"/>
                                        <field name="whatsapp_business_account_id" class="w-100" placeholder="e.g. 2101618547113454"/>
                                    </div>
                                    <div class="mb-3">
                                        <label for="whatsapp_api_version" class="fw-bold d-block mb-1" string="Graph API Version"/>
                                        <field name="whatsapp_api_version" class="w-100" placeholder="v25.0"/>
                                    </div>
                                    <div>
                                        <button name="action_test_whatsapp_connection"
                                                type="object"
                                                string="Test WhatsApp Connection"
                                                class="btn-primary"
                                                icon="link"/>
                                    </div>
                                </div>
                            </setting>

                            <setting id="setting_whatsapp_templates_webhooks"
                                     string="Templates &amp; Webhook Setup"
                                     help="Template parameters and Meta Webhook callback configuration.">
                                <div class="content-group w-100">
                                    <div class="mb-2">
                                        <label for="whatsapp_template_name" class="fw-bold d-block mb-1" string="Task Notification Template Name"/>
                                        <field name="whatsapp_template_name" class="w-100" placeholder="hotel_task_notification"/>
                                    </div>
                                    <div class="mb-2">
                                        <label for="whatsapp_template_language" class="fw-bold d-block mb-1" string="Template Language Code"/>
                                        <field name="whatsapp_template_language" class="w-100" placeholder="en"/>
                                    </div>
                                    <div class="mb-2">
                                        <label for="whatsapp_webhook_url" class="fw-bold d-block mb-1" string="Webhook Callback URL"/>
                                        <div class="p-2 bg-light border rounded font-monospace small text-dark">
                                            <field name="whatsapp_webhook_url" readonly="1" class="w-100"/>
                                        </div>
                                    </div>
                                    <div class="mb-2">
                                        <label for="whatsapp_webhook_verify_token" class="fw-bold d-block mb-1" string="Webhook Verify Token"/>
                                        <field name="whatsapp_webhook_verify_token" class="w-100" placeholder="hotel_whatsapp_secret"/>
                                    </div>
                                </div>
                            </setting>

                        </block>

                    </app>

                </xpath>

            </field>

        </record>

        <record id="action_hotel_config_settings" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="context">{'module' : 'vs_hotel_management', 'bin_size': False}</field>
        </record>

    </data>
</odoo>