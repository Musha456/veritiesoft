<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_form_hotel_guest" model="ir.ui.view">
        <field name="name">res.partner.form.hotel.guest</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_send_whatsapp_message"
                            type="object"
                            string="Send WhatsApp"
                            class="btn-primary"
                            icon="fa-whatsapp"/>
                </header>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_view_hotel_reservations"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-calendar">
                    <field name="reservation_count"
                           widget="statinfo"
                           string="Reservations"/>
                </button>

                <button name="action_view_hotel_room_bookings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-bed">
                    <field name="room_booking_count"
                           widget="statinfo"
                           string="Room Bookings"/>
                </button>

                <button name="action_view_hotel_folios"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card">
                    <field name="folio_count"
                           widget="statinfo"
                           string="Folios"/>
                </button>

                <button name="action_view_hotel_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o">
                    <field name="hotel_invoice_count"
                           widget="statinfo"
                           string="Invoices"/>
                </button>

                <button name="action_view_agent_commissions"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-percent"
                        invisible="not is_travel_agent">
                    <field name="agent_commission_count"
                           widget="statinfo"
                           string="Commissions"/>
                </button>

                <button name="action_view_whatsapp_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-whatsapp">
                    <field name="whatsapp_log_count"
                           widget="statinfo"
                           string="WhatsApp"/>
                </button>

                <button name="action_view_housekeeping_tasks"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-paint-brush"
                        invisible="housekeeping_task_count == 0">
                    <field name="housekeeping_task_count"
                           widget="statinfo"
                           string="HK Tasks"/>
                </button>

                <button name="action_view_maintenance_tasks"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="maintenance_task_count == 0">
                    <field name="maintenance_task_count"
                           widget="statinfo"
                           string="Maint. Tasks"/>
                </button>

            </xpath>

            <xpath expr="//sheet/div[@name='button_box']" position="after">

                <div class="oe_title d-flex gap-4">

                    <div>
                        <label for="is_hotel_guest" class="fw-bold me-2"/>
                        <field name="is_hotel_guest" widget="boolean_toggle"/>
                    </div>

                    <div>
                        <label for="is_travel_agent" class="fw-bold me-2"/>
                        <field name="is_travel_agent" widget="boolean_toggle"/>
                    </div>

                </div>

            </xpath>

            <xpath expr="//sheet/notebook" position="inside">

                <page string="Guest Info"
                      name="hotel_guest"
                      invisible="not is_hotel_guest">

                    <group>

                        <group string="Guest Information">

                            <field name="guest_code"
                                   readonly="1"/>

                            <field name="nationality"/>

                            <field name="date_of_birth"/>

                            <field name="gender"/>

                        </group>

                        <group string="Identification">

                            <field name="id_type"/>

                            <field name="id_number"/>

                        </group>

                    </group>

                    <group string="Notes">

                        <field name="hotel_guest_notes"
                               nolabel="1"
                               placeholder="Add guest-specific notes..."/>

                    </group>

                </page>

                <page string="Travel Agent"
                      name="travel_agent_info"
                      invisible="not is_travel_agent">

                    <group>

                        <group string="Commission Settings">
                            <field name="agent_commission_percentage"/>
                        </group>

                    </group>

                </page>

                <page string="Hotel Staff"
                      name="hotel_staff_info"
                      invisible="not is_housekeeping_staff and not is_housekeeping_manager and not is_maintenance_staff and not is_maintenance_manager">

                    <group>

                        <group string="Housekeeping Roles">

                            <field name="is_housekeeping_staff"
                                   widget="boolean_toggle"/>

                            <field name="is_housekeeping_manager"
                                   widget="boolean_toggle"/>

                        </group>

                        <group string="Maintenance Roles">

                            <field name="is_maintenance_staff"
                                   widget="boolean_toggle"/>

                            <field name="is_maintenance_manager"
                                   widget="boolean_toggle"/>

                        </group>

                    </group>

                </page>

            </xpath>

        </field>
    </record>

    <record id="view_hotel_guest_list" model="ir.ui.view">
        <field name="name">res.partner.hotel.guest.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">

            <list string="Hotel Guests">

                <field name="guest_code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="nationality"/>
                <field name="id_type"/>
                <field name="id_number"/>
                <field name="reservation_count"/>
                <field name="room_booking_count"/>

            </list>

        </field>
    </record>

    <record id="view_hotel_travel_agent_list" model="ir.ui.view">
        <field name="name">res.partner.hotel.travel.agent.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list string="Travel Agents">
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="agent_commission_percentage" string="Default Commission (%)"/>
                <field name="agent_commission_count" string="Commissions"/>
                <field name="reservation_count" string="Bookings"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_guest_search" model="ir.ui.view">
        <field name="name">res.partner.hotel.guest.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">

            <search string="Guests">

                <field name="guest_code"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="id_number"/>

                <separator/>

                <filter name="active_guests"
                        string="Active Guests"
                        domain="[('active', '=', True)]"/>

                <filter name="inactive_guests"
                        string="Archived Guests"
                        domain="[('active', '=', False)]"/>

                <group>

                    <filter name="group_nationality"
                            string="Nationality"
                            context="{'group_by': 'nationality'}"/>

                    <filter name="group_gender"
                            string="Gender"
                            context="{'group_by': 'gender'}"/>

                </group>

            </search>

        </field>
    </record>

    <record id="action_hotel_guest" model="ir.actions.act_window">
        <field name="name">Guests</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hotel_guest_list"/>
        <field name="search_view_id" ref="view_hotel_guest_search"/>
        <field name="domain">[('is_hotel_guest', '=', True)]</field>
        <field name="context">{'default_is_hotel_guest': True}</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('vs_hotel_management.group_hotel_reservation_user'),
            ref('vs_hotel_management.group_hotel_reservation_manager'),
            ref('vs_hotel_management.group_hotel_gm_user'),
            ref('vs_hotel_management.group_hotel_manager'),
            ref('vs_hotel_management.group_hotel_gm_bridge'),
            ref('vs_hotel_management.group_hotel_admin_user'),
            ref('vs_hotel_management.group_hotel_admin'),
            ref('vs_hotel_management.group_hotel_admin_bridge'),
        ])]"/>
    </record>

    <record id="action_hotel_travel_agent" model="ir.actions.act_window">
        <field name="name">Travel Agents</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_hotel_travel_agent_list"/>
        <field name="domain">[('is_travel_agent', '=', True)]</field>
        <field name="context">{'default_is_travel_agent': True, 'default_is_company': True}</field>
        <field name="group_ids" eval="[(6, 0, [
            ref('vs_hotel_management.group_hotel_reservation_user'),
            ref('vs_hotel_management.group_hotel_reservation_manager'),
            ref('vs_hotel_management.group_hotel_billing_manager'),
            ref('vs_hotel_management.group_hotel_gm_user'),
            ref('vs_hotel_management.group_hotel_manager'),
            ref('vs_hotel_management.group_hotel_gm_bridge'),
            ref('vs_hotel_management.group_hotel_admin_user'),
            ref('vs_hotel_management.group_hotel_admin'),
            ref('vs_hotel_management.group_hotel_admin_bridge'),
        ])]"/>
    </record>

</odoo>
