<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">

            <form string="Hotel Reservation">

                <header>

                    <div class="d-flex flex-wrap gap-2">

                        <button name="action_confirm"
                                string="Confirm"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>

                        <button name="action_reserve"
                                string="Reserve"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'confirmed'"/>

                        <button name="action_check_in"
                                string="Check In"
                                type="object"
                                class="btn-success"
                                invisible="state != 'reserved'"/>

                        <button name="action_check_out"
                                string="Check Out"
                                type="object"
                                class="btn-danger"
                                invisible="state != 'checked_in'"/>

                        <button name="action_complete"
                                string="Complete"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'checked_out'"/>

                        <button name="action_no_show"
                                string="No Show"
                                type="object"
                                class="btn-secondary"
                                invisible="state not in ('confirmed', 'reserved')"/>

                        <button name="action_cancel"
                                string="Cancel"
                                type="object"
                                class="btn-secondary"
                                groups="vs_hotel_management.group_hotel_room_manager"
                                invisible="state in ('draft', 'cancelled', 'completed', 'checked_in', 'checked_out', 'no_show')"/>

                         <button name="action_reset_to_draft"
                                string="Reset to Draft"
                                type="object"
                                class="btn-secondary"
                                invisible="state not in ('confirmed', 'cancelled', 'reserved', 'no_show')"/>

                        <button name="action_send_reservation_email"
                                string="Send by Email"
                                type="object"
                                class="btn-secondary"
                                invisible="state == 'draft'"/>

                        <button name="action_send_reservation_whatsapp"
                                string="Send by WhatsApp"
                                type="object"
                                class="btn-secondary"
                                icon="chat"
                                invisible="state == 'draft'"/>

                    </div>


                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,confirmed,reserved,checked_in,checked_out,completed,no_show"/>

                </header>

                <sheet>

                    <!-- ================================================= -->
                    <!-- Smart Buttons -->
                    <!-- ================================================= -->

                    <div class="oe_button_box" name="button_box">

                        <button name="action_open_room_bookings"
                                type="object"
                                class="oe_stat_button"
                                icon="bed"
                                invisible="room_booking_count == 0">

                            <field name="room_booking_count"
                                   widget="statinfo"
                                   string="Room Bookings"/>

                        </button>

                        <button name="action_view_guest_folios"
                                type="object"
                                class="oe_stat_button"
                                icon="payments"
                                invisible="folio_count == 0">
                            <field name="folio_count"
                                   widget="statinfo"
                                   string="Folios"/>
                        </button>

                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="receipt_long"
                                invisible="invoice_amount == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="invoice_amount"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>

                        <button name="action_view_whatsapp_logs"
                                type="object"
                                class="oe_stat_button"
                                icon="chat"
                                invisible="whatsapp_log_count == 0">
                            <field name="whatsapp_log_count"
                                   widget="statinfo"
                                   string="WhatsApp"/>
                        </button>

                    </div>

                    <!-- ================================================= -->
                    <!-- Title -->
                    <!-- ================================================= -->

                    <div class="oe_title">

                        <h1>
                            <field name="name"
                                   placeholder="Reservation Reference"/>
                        </h1>

                    </div>

                    <!-- ================================================= -->
                    <!-- Reservation Information -->
                    <!-- ================================================= -->

                    <group string="Guest Information" col="3">
                        <group colspan="1">
                            <field name="partner_id" readonly="state not in ['draft','confirmed']" required="1"/>
                        </group>
                        <group colspan="1">
                            <field name="guest_phone"/>
                        </group>
                        <group colspan="1">
                            <field name="guest_email"/>
                        </group>


                    </group>

                    <group string="Reservation Information" col="3">
                        <group colspan="1">
                            <field name="hotel_id" readonly="state not in ['draft','confirmed']" required="1"/>
                        </group>
                        <group colspan="1">
                            <field name="booking_date" readonly="state not in ['draft','confirmed']"/>
                        </group>
                        <group colspan="1">
                            <field name="company_id" readonly="state not in ['draft','confirmed']"/>
                        </group>
                        <field name="currency_id" invisible="1"/>
                    </group>

                    <!-- ================================================= -->
                    <!-- Stay Information -->
                    <!-- ================================================= -->

                    <group string="Stay" col="2">
                        <group colspan="1">
                            <field name="check_in" widget="daterange" options="{'end_date_field':'check_out'}" readonly="state not in ['draft','confirmed']"
                                   required="1"/>
                        </group>
                        <group colspan="1">
                            <field name="night_count" string="Total Night" readonly="1"/>
                        </group>
                    </group>

                    <group string="Guests" col="4">
                        <group colspan="1">
                            <field name="adult_count"/>
                        </group>
                        <group colspan="1">
                            <field name="child_count"/>
                        </group>
                        <group colspan="1">
                            <field name="guest_count" readonly="1"/>
                        </group>
                        <group colspan="1">
                            <field name="room_count" readonly="1"/>
                        </group>
                    </group>


                    <!-- ================================================= -->
                    <!-- Reservation Lines -->
                    <!-- ================================================= -->

                    <notebook>
                        <page string="Rooms">

                            <field name="line_ids"
                                   mode="list,form"
                                   nolabel="1"
                                   context="{'default_reservation_id': id,'default_hotel_id': hotel_id, 'default_check_in': check_in, 'default_check_out': check_out}">
                                <list>

                                    <field name="available_room_ids" column_invisible="1"/>
                                    <field name="hotel_id" column_invisible="1"/>
                                    <!--                                    <field name="building_id" optional="show"/>-->
                                    <!--                                    <field name="floor_id" optional="show"/>-->
                                    <!--                                    <field name="room_category_id" optional="show"/>-->
                                    <field name="room_id"
                                           domain="[('id', 'in', available_room_ids)]"
                                           required="1"/>

                                    <!--                                    <field name="check_in"/>-->
                                    <!--                                    <field name="check_out"/>-->

                                    <field name="guest_count"
                                           sum="Total Guests"/>

                                    <field name="room_amount"
                                           sum="Room Amount"/>

                                    <field name="product_id" optional="hide"/>

                                    <field name="service_amount"
                                           readonly="1"
                                           sum="Service Amount"/>


                                    <field name="discount_amount"
                                           optional="show"
                                           readonly="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           sum="Total Discount"/>

                                    <field name="tax_ids" widget="many2many_tags" optional="show"/>

                                    <field name="total_tax_amount"
                                           optional="show"
                                           readonly="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           sum="Total Tax Amount"/>

                                    <field name="total"
                                           readonly="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           sum="Total"/>

                                </list>
                                <form string="Reservation Room">

                                    <sheet>
                                        <field name="available_room_ids" invisible="1"/>

                                        <group string="Room Information" col="3">
                                            <group colspan="1">
                                                <field name="reservation_id" invisible="True"/>
                                                <field name="room_booking_id" readonly="1"
                                                       invisible="not room_booking_id"/>
                                                <field name="hotel_id" required="1"/>
                                                <field name="building_id" readonly="reservation_id.state in ['confirmed']"/>
                                                <field name="floor_id" readonly="reservation_id.state in ['draft','confirmed']"/>
                                            </group>
                                            <group colspan="1">
                                                <field name="room_category_id" readonly="reservation_id.state in ['draft','confirmed']"/>
                                                <field name="room_id"
                                                       domain="[('id', 'in', available_room_ids)]"
                                                       required="1" readonly="reservation_id.state in ['draft','confirmed']"/>
                                            </group>
                                            <group colspan="1">
                                                <field name="rate_plan_id"
                                                       domain="[('room_category_ids', 'in', [room_category_id])]" readonly="reservation_id.state in ['draft','confirmed']"/>
                                                <field name="room_price" readonly="1" invisible="not rate_plan_id"/>
                                            </group>
                                        </group>

                                        <!--                                        <group string="Stay Information" col="3">-->
                                        <!--                                            <group colspan="1">-->
                                        <!--                                                <field name="check_in" readonly="1"/>-->
                                        <!--                                            </group>-->
                                        <!--                                            <group colspan="2">-->
                                        <!--                                                <field name="check_out" readonly="1"/>-->
                                        <!--                                            </group>-->
                                        <!--                                        </group>-->
                                                                                <group string="Guest Information" col="3">
                                                                                    <group colspan="1">
                                                                                        <field name="night_count" readonly="1"/>
                                                                                    </group>
                                                                                    <group colspan="1">
                                                                                        <field name="adults"/>
                                                                                    </group>
                                                                                    <group colspan="1">
                                                                                        <field name="children"/>
                                                                                    </group>
                                                                                </group>
                                        <notebook>

                                            <page string="Services">

                                                <field name="service_line_ids">

                                                    <list editable="bottom">
                                                        <field name="product_id"/>
                                                        <field name="serve_date"/>
                                                        <field name="quantity"/>
                                                        <field name="price_unit"/>
                                                        <field name="discount_id"/>
                                                        <field name="discount_amount" readonly="1" sum="Discount"/>
                                                        <field name="tax_ids" widget="many2many_tags"/>
                                                        <!--                                                        <field name="tax_amount" readonly="1" sum="Tax"/>-->
                                                        <!--                                                        <field name="total_tax_amount" readonly="1" sum="Tax Amount"/>-->
                                                        <field name="subtotal" readonly="1" sum="Subtotal"/>
                                                        <field name="total" readonly="1" sum="Total"/>
                                                    </list>

                                                </field>

                                                <!--                                                <group class="oe_subtotal_footer">-->
                                                <!--                                                    <field name="service_amount" readonly="1"/>-->
                                                <!--                                                    <field name="service_tax_amount" readonly="1"/>-->
                                                <!--                                                </group>-->

                                            </page>

                                            <page string="Pricing">

                                                <group string="Room Pricing" col="3">
                                                    <group colspan="1">
                                                        <field name="room_amount" readonly="1"/>
                                                    </group>
                                                    <group colspan="1">
                                                        <field name="discount_id"/>
                                                    </group>
                                                    <group colspan="1">
                                                        <field name="discount_amount" invisible="not discount_id"
                                                               readonly="1"/>
                                                    </group>
                                                </group>

                                                <group string="Room Taxes" col="3">
                                                    <group colspan="1">
                                                        <field name="tax_ids" widget="many2many_tags"/>
                                                    </group>
                                                    <group colsan="2">
                                                        <field name="tax_amount" invisible="not tax_ids" readonly="1"/>
                                                    </group>
                                                </group>

                                            </page>

                                            <page string="Notes">
                                                <field name="note" placeholder="Add notes for this room..."/>
                                            </page>

                                        </notebook>

                                        <group class="oe_subtotal_footer">

                                            <!-- Charges -->
                                            <field name="room_amount" readonly="1"/>
                                            <field name="service_amount" readonly="1"/>

                                            <separator string="Discount"/>

                                            <field name="discount_amount" readonly="1"/>
                                            <field name="service_line_discounts" readonly="1"/>
                                            <field name="total_discount_amount" readonly="1"/>

                                            <separator string="Tax"/>

                                            <field name="tax_amount" readonly="1"/>
                                            <field name="service_tax_amount" readonly="1"/>
                                            <field name="total_tax_amount" readonly="1"/>

                                            <field name="subtotal" readonly="1"/>

                                            <field name="total"
                                                   readonly="1"
                                                   class="oe_subtotal"/>

                                        </group>

                                    </sheet>

                                </form>

                            </field>

                        </page>

                        <page string="Guest Info"
                              name="hotel_guest_info"
                        >

                            <group>

                                <group string="Guest Information">

                                    <field name="nationality"/>

                                    <field name="date_of_birth"/>

                                    <field name="gender"/>

                                </group>

                                <group string="Identification">

                                    <field name="id_type"/>

                                    <field name="id_number"/>

                                </group>

                            </group>

                        </page>

                        <page string="Extra Information">
                            <group>
                                <group string="Booking Details">
                                    <field name="booking_source"/>
                                    <field name="reference"/>
                                    <field name="arrival_time"/>
                                    <field name="departure_time"/>
                                </group>
                                <group string="Travel Agent Details" invisible="booking_source != 'travel_agent'">
                                    <field name="agent_id"/>
                                    <field name="agent_commission_percentage"/>
                                    <field name="agent_commission_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </group>
                            </group>
                        </page>

                        <!-- ================================================= -->
                        <!-- Notes -->
                        <!-- ================================================= -->
                        <page string="Notes">

                            <group string="Guest Notes">
                                <field name="guest_notes" nolabel="1" placeholder="Notes from or about the guest..."/>
                            </group>

                            <group string="Internal Notes">
                                <field name="internal_notes" nolabel="1" placeholder="Internal reservation notes..."/>
                            </group>

                        </page>

                    </notebook>

                    <!-- ================================================= -->
                    <!-- Financial Summary & Folio Status Footer           -->
                    <!-- ================================================= -->

                    <group class="mt-4">

                        <group string="Billing &amp; Payment">
                            <field name="folio_id" readonly="1" invisible="not folio_id"/>
                            <field name="payment_status"
                                   widget="badge"
                                   decoration-success="payment_status == 'paid'"
                                   decoration-warning="payment_status == 'partially_paid'"
                                   decoration-danger="payment_status == 'unpaid'"/>
                            <field name="agent_id" readonly="1" invisible="not agent_id"/>
                            <field name="agent_commission_amount" readonly="1" invisible="not agent_id"/>
                        </group>

                        <group class="oe_subtotal_footer" string="Reservation Summary">
                            <field name="room_amount" readonly="1"/>
                            <field name="service_amount" readonly="1"/>

                            <separator string="Adjustments"/>
                            <field name="discount_amount" readonly="1" string="Discounts"/>
                            <field name="tax_amount" readonly="1" string="Taxes"/>

                            <field name="total_amount" class="oe_subtotal_footer_separator fw-bold fs-5" readonly="1"/>
                        </group>

                    </group>

                    <!-- ================================================= -->
                    <!-- Chatter -->
                    <!-- ================================================= -->

                    <chatter/>

                </sheet>

            </form>

        </field>
    </record>

    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">

            <calendar string="Reservations"
                      date_start="check_in"
                      date_stop="check_out"
                      color="hotel_id"
                      mode="month"
                      quick_create="0"
                      event_open_popup="1">

                <field name="name"/>
                <field name="partner_id"/>
                <field name="hotel_id"/>
                <field name="state"/>
                <field name="total_amount"/>

            </calendar>

        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Hotel Reservation Tree -->
    <!-- ========================================================= -->
    <record id="view_hotel_reservation_list" model="ir.ui.view">
        <field name="name">hotel.reservation.list</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">

            <list string="Reservations">

                <field name="name"/>

                <field name="partner_id"/>

                <field name="hotel_id"/>

                <field name="check_in"/>

                <field name="check_out"/>

                <field name="night_count"/>

                <field name="room_count"/>

                <field name="adult_count"/>

                <field name="child_count"/>

                <field name="total_amount"/>

                <field name="state"
                       widget="badge"/>

            </list>

        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Hotel Reservation Search -->
    <!-- ========================================================= -->
    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">

            <search string="Reservations">

                <field name="name"
                       string="Reference"/>

                <field name="partner_id"
                       string="Guest"/>

                <field name="hotel_id"
                       string="Hotel"/>

                <field name="check_in"/>

                <field name="check_out"/>

                <field name="state"/>

                <separator/>

                <!-- Status -->

                <filter name="draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="confirmed"
                        string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>

                <filter name="reserved"
                        string="Reserved"
                        domain="[('state', '=', 'reserved')]"/>

                <filter name="checked_in"
                        string="Checked In"
                        domain="[('state', '=', 'checked_in')]"/>

                <filter name="checked_out"
                        string="Checked Out"
                        domain="[('state', '=', 'checked_out')]"/>

                <filter name="completed"
                        string="Completed"
                        domain="[('state', '=', 'completed')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <filter name="no_show"
                        string="No Show"
                        domain="[('state', '=', 'no_show')]"/>

                <filter name="not_completed"
                        string="In-progress Reservations"
                        domain="[('state', '!=', 'completed')]"/>

                <separator/>

                <!-- Date Filters -->

                <filter name="check_in_today"
                        string="Check-in Today"
                        domain="[
                        ('check_in', '&gt;=', context_today()),
                        ('check_in', '&lt;', context_today() + relativedelta(days=1))
                    ]"/>

                <filter name="check_out_today"
                        string="Check-out Today"
                        domain="[
                        ('check_out', '&gt;=', context_today()),
                        ('check_out', '&lt;', context_today() + relativedelta(days=1))
                    ]"/>

                <filter name="upcoming"
                        string="Upcoming"
                        domain="[
                        ('check_in', '&gt;=', context_today()),
                        ('state', 'in', ('confirmed', 'reserved'))
                    ]"/>

                <separator/>

                <!-- Group By -->

                <group>

                    <filter name="group_hotel"
                            string="Hotel"
                            context="{'group_by': 'hotel_id'}"/>

                    <filter name="group_guest"
                            string="Guest"
                            context="{'group_by': 'partner_id'}"/>

                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>

                    <filter name="group_check_in"
                            string="Check-in"
                            context="{'group_by': 'check_in'}"/>

                    <filter name="group_check_out"
                            string="Check-out"
                            context="{'group_by': 'check_out'}"/>

                </group>

            </search>

        </field>
    </record>
    <record id="view_hotel_reservation_kanban" model="ir.ui.view">
        <field name="name">hotel.reservation.kanban</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">

            <kanban create="1"
                    edit="1"
                    delete="1">

                <field name="name"/>
                <field name="partner_id"/>
                <field name="hotel_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="room_count"/>
                <field name="guest_count"/>
                <field name="total_amount"/>
                <field name="currency_id"/>
                <field name="state"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click p-2 d-flex flex-column justify-content-between h-100">

                            <!-- Top Header: Guest Name & Status Badge -->
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                <div class="text-truncate">
                                    <div class="fw-bold fs-6 text-dark text-truncate">
                                        <field name="partner_id"/>
                                    </div>
                                    <div class="text-muted small text-truncate">
                                        <i class="oi oi-apartment me-1 text-secondary"/>
                                        <field name="hotel_id"/>
                                    </div>
                                </div>
                                <field name="state" widget="badge"/>
                            </div>

                            <!-- Body: Horizontally Aligned Check-In & Check-Out Times, Booked Rooms, Guests -->
                            <div class="my-2">
                                <div class="row g-2 align-items-center py-1">
                                    <div class="col-6 d-flex align-items-center gap-1 text-truncate">
                                        <i class="oi oi-calendar-today text-primary small flex-shrink-0"/>
                                        <div class="text-truncate">
                                            <div class="text-muted" style="font-size: 0.72rem; line-height: 1.1;">Check-In</div>
                                            <strong class="text-dark small"><field name="check_in"/></strong>
                                        </div>
                                    </div>
                                    <div class="col-6 d-flex align-items-center gap-1 text-truncate">
                                        <i class="oi oi-calendar-today text-secondary small flex-shrink-0"/>
                                        <div class="text-truncate">
                                            <div class="text-muted" style="font-size: 0.72rem; line-height: 1.1;">Check-Out</div>
                                            <strong class="text-dark small"><field name="check_out"/></strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-2 pt-1 text-nowrap">
                                    <span class="badge rounded-pill bg-light text-dark border me-2">
                                        <i class="oi oi-bed me-1 text-primary"/>
                                        <field name="room_count"/> Rooms
                                    </span>
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        <i class="oi oi-person me-1 text-secondary"/>
                                        <field name="guest_count"/> Guests
                                    </span>
                                </div>
                            </div>

                            <!-- Footer: Total Amount -->
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <span class="text-muted small fw-semibold">Total Amount</span>
                                <strong class="fs-6 text-primary">
                                    <field name="total_amount"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </strong>
                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>
    <!-- ========================================================= -->
    <!-- Hotel Reservation Action -->
    <!-- ========================================================= -->

    <record id="action_hotel_reservation" model="ir.actions.act_window">

        <field name="name">Reservations</field>

        <field name="res_model">hotel.reservation</field>

        <field name="context">{'search_default_not_completed':1}</field>

        <field name="view_mode">kanban,list,calendar,form</field>

        <field name="search_view_id"
               ref="view_hotel_reservation_search"/>

    </record>

    <!-- ========================================================= -->
    <!-- Hotel Reservation Check-in Action -->
    <!-- ========================================================= -->

    <record id="action_hotel_reservation_checked_in" model="ir.actions.act_window">

        <field name="name">Checked In</field>

        <field name="res_model">hotel.reservation</field>

        <field name="view_mode">kanban,list,calendar,form</field>

        <field name="search_view_id" ref="view_hotel_reservation_search"/>

        <field name="domain">[('state', '=', 'checked_in')]</field>

    </record>

    <!-- ========================================================= -->
    <!-- Hotel Reservation Check-out Action -->
    <!-- ========================================================= -->

    <record id="action_hotel_reservation_checked_out" model="ir.actions.act_window">

        <field name="name">Checked Out</field>

        <field name="res_model">hotel.reservation</field>

        <field name="view_mode">kanban,list,calendar,form</field>

        <field name="search_view_id" ref="view_hotel_reservation_search"/>

        <field name="domain">[('state', '=', 'checked_out')]</field>

    </record>


</odoo>