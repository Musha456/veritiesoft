<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hotel_housekeeping_list" model="ir.ui.view">
        <field name="name">hotel.housekeeping.list</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">

            <list string="Housekeeping"
                  create="0"
                  edit="0"
                  delete="0">

                <field name="name"/>
                <field name="room_id"/>
                <field name="room_category_id"/>
                <field name="reservation_id"/>
                <field name="housekeeping_type"/>
                <field name="scheduled_date"/>
                <field name="assigned_to"/>
                <field name="priority"/>
                <field name="state"
                       widget="badge"/>

            </list>

        </field>
    </record>

    <record id="view_hotel_housekeeping_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.kanban</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">

            <kanban default_group_by="state"
                    create="0"
                    edit="0"
                    delete="0">

                <field name="name"/>
                <field name="room_id"/>
                <field name="room_category_id"/>
                <field name="reservation_id"/>
                <field name="housekeeping_type"/>
                <field name="scheduled_date"/>
                <field name="assigned_to"/>
                <field name="priority"/>
                <field name="state"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <strong>
                                    <field name="name"/>
                                </strong>

                                <field name="priority"
                                       widget="priority"/>

                            </div>

                            <div class="mb-2">
                                <i class="fa fa-bed me-1"/>
                                <strong>
                                    <field name="room_id"/>
                                </strong>
                            </div>

                            <div class="text-muted mb-2">
                                <i class="fa fa-tag me-1"/>
                                <field name="housekeeping_type"/>
                            </div>

                            <div class="text-muted mb-2">
                                <i class="fa fa-calendar me-1"/>
                                <field name="scheduled_date"/>
                            </div>

                            <div t-if="record.reservation_id.raw_value"
                                 class="text-muted mb-2">

                                <i class="fa fa-bookmark me-1"/>
                                <field name="reservation_id"/>

                            </div>

                            <div t-if="record.assigned_to.raw_value"
                                 class="text-muted">

                                <i class="fa fa-user me-1"/>
                                <field name="assigned_to"/>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>

    <record id="view_hotel_housekeeping_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.form</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">

            <form string="Housekeeping"
                  create="0"
                  edit="0"
                  delete="0">

                <header>

                    <button name="action_start"
                            string="Start Cleaning"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'pending'"/>

                    <button name="action_assign_task"
                            string="Assign"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ('pending', 'in_progress')"/>

                    <button name="action_done"
                            string="Mark Done"
                            type="object"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('done', 'cancelled')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="
                           pending,
                           in_progress,
                           done,
                           cancelled"/>

                </header>

                <sheet>

                    <div class="oe_title">

                        <h1>
                            <field name="name"
                                   readonly="1"/>
                        </h1>

                    </div>

                    <group col="4">

                        <group string="Room">

                            <field name="room_id"
                                   readonly="1"/>

                            <field name="room_category_id"
                                   readonly="1"/>

                            <field name="housekeeping_type"
                                   readonly="1"/>

                        </group>

                        <group string="Reference">

                            <field name="reservation_id"
                                   readonly="1"/>

                            <field name="room_booking_id"
                                   readonly="1"/>

                        </group>

                        <group string="Schedule">

                            <field name="scheduled_date"
                                   readonly="1"/>

                            <field name="assigned_to_domain" invisible="1"/>
                            <field name="assigned_to"
                                   domain="[('id', 'in', assigned_to_domain)]"
                                   readonly="state != 'pending'"/>

                            <field name="priority"
                                   readonly="1"/>

                        </group>

                        <group string="Timing">

                            <field name="started_at"
                                   readonly="1"/>

                            <field name="completed_at"
                                   readonly="1"/>

                        </group>

                    </group>

                    <separator string="Notes"/>

                    <field name="notes"
                           readonly="1"
                           placeholder="Housekeeping notes..."/>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <record id="view_hotel_housekeeping_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.search</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">

            <search string="Housekeeping">

                <field name="name"/>
                <field name="room_id"/>
                <field name="room_category_id"/>
                <field name="reservation_id"/>
                <field name="assigned_to"/>
                <field name="housekeeping_type"/>
                <field name="state"/>

                <separator/>

                <filter name="pending"
                        string="Pending"
                        domain="[('state', '=', 'pending')]"/>

                <filter name="in_progress"
                        string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>

                <filter name="done"
                        string="Completed"
                        domain="[('state', '=', 'done')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <separator/>

                <filter name="high_priority"
                        string="High Priority"
                        domain="[('priority', '=', '1')]"/>

                <filter name="today"
                        string="Today"
                        domain="[
                        ('scheduled_date', '>=', context_today()),
                        ('scheduled_date', '&lt;',
                         context_today() + relativedelta(days=1))
                    ]"/>

                <separator/>

                <group expand="0"
                       string="Group By">

                    <filter name="group_room"
                            string="Room"
                            context="{'group_by': 'room_id'}"/>

                    <filter name="group_category"
                            string="Room Category"
                            context="{'group_by': 'room_category_id'}"/>

                    <filter name="group_type"
                            string="Cleaning Type"
                            context="{'group_by': 'housekeeping_type'}"/>

                    <filter name="group_assigned"
                            string="Assigned To"
                            context="{'group_by': 'assigned_to'}"/>

                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>

                </group>

            </search>

        </field>
    </record>

    <record id="action_hotel_housekeeping" model="ir.actions.act_window">

        <field name="name">Housekeeping</field>

        <field name="res_model">hotel.housekeeping</field>

        <field name="view_mode">kanban,list,form</field>

        <field name="view_id"
               ref="view_hotel_housekeeping_kanban"/>

        <field name="search_view_id"
               ref="view_hotel_housekeeping_search"/>

        <field name="context">
            {
            "search_default_pending": 1
            }
        </field>

    </record>

</odoo>