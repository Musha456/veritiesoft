<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hotel_housekeeping_list" model="ir.ui.view">
        <field name="name">hotel.housekeeping.list</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">

            <list string="Housekeeping"
                  create="0"
                  edit="0"
                  delete="0">

                <field name="name"/>
                <field name="room_id"/>
                <field name="room_category_id"/>
                <field name="housekeeping_type"/>
                <field name="scheduled_date"/>
                <field name="assigned_to"/>
                <field name="priority"/>
                <field name="state"
                       widget="badge"/>

            </list>

        </field>
    </record>

    <record id="view_hotel_housekeeping_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.kanban</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">

            <kanban default_group_by="state"
                    create="0"
                    edit="0">

                <field name="name"/>
                <field name="room_id"/>
                <field name="room_category_id"/>
                <field name="housekeeping_type"/>
                <field name="scheduled_date"/>
                <field name="assigned_to"/>
                <field name="priority"/>
                <field name="state"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click">

                            <div class="d-flex justify-content-between align-items-center mb-2">

                                <strong>
                                    <field name="name"/>
                                </strong>

                                <field name="priority"
                                       widget="priority"/>

                            </div>

                            <div class="mb-2">
                                <i class="fa fa-bed me-1" title="Room"/>
                                <strong>
                                    <field name="room_id"/>
                                </strong>
                            </div>

                            <div class="text-muted mb-2">
                                <i class="fa fa-tag me-1" title="Service"/>
                                <field name="housekeeping_type"/>
                            </div>

                            <div class="text-muted mb-2">
                                <i class="fa fa-calendar me-1" title="Date"/>
                                <field name="scheduled_date" title="Date"/>
                            </div>

                            <div t-if="record.assigned_to.raw_value"
                                 class="text-muted">

                                <i class="fa fa-user me-1" title="Assigned To"/>
                                <field name="assigned_to"/>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>

    <record id="view_hotel_housekeeping_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.form</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <form string="Housekeeping"
                  create="0"
                  delete="0">

                <header>
                    <button name="action_start"
                            string="Start Cleaning"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'pending'"/>

                    <button name="action_done"
                            string="Complete Task"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'in_progress'"/>

                    <button name="action_cancel"
                            string="Cancel Task"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'pending'"/>

                    <field name="duration_seconds"
                           widget="hotel_task_timer"
                           nolabel="1"
                           invisible="state not in ('in_progress', 'done')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,in_progress,done,cancelled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Task Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group col="2">
                        <group string="Room Information">
                            <field name="room_id" readonly="1"/>

                            <!-- These related fields must exist on
                                 hotel.housekeeping. -->
                            <field name="hotel_id" readonly="1"/>
                            <field name="building_id" readonly="1"/>
                            <field name="floor_id" readonly="1"/>
                        </group>

                        <group string="Assignment &amp; Schedule">
                            <field name="assigned_to_domain" invisible="1"/>

                            <field name="assigned_to"
                                   readonly="state != 'pending'"/>

                            <field name="scheduled_date"
                                   readonly="state != 'pending'"/>

                            <field name="priority"
                                   widget="priority"
                                   readonly="state != 'pending'"/>
                        </group>

                    </group>

                    <group string="Instructions" col="2">
                        <field name="instruction_notes"
                               placeholder="Enter cleaning instructions, special requests, or inspection requirements..."
                               readonly="state != 'pending'"
                               nolabel="1"/>
                    </group>

                    <group string="Execution Details" invisible="state == 'pending'" col="2">
                        <group>
                            <field name="started_at" readonly="1"/>

                        </group>
                        <group>
                            <field name="completed_at" readonly="1"/>
                        </group>
                    </group>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_housekeeping_search" model="ir.ui.view">
        <field name="name">hotel.housekeeping.search</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">

            <search string="Housekeeping">

                <field name="name"/>
                <field name="room_id"/>
                <field name="room_category_id"/>
                <field name="assigned_to"/>
                <field name="housekeeping_type"/>
                <field name="state"/>

                <separator/>

                <filter name="pending"
                        string="Pending"
                        domain="[('state', '=', 'pending')]"/>

                <filter name="in_progress"
                        string="In Progress"
                        domain="[('state', '=', 'in_progress')]"/>

                <filter name="done"
                        string="Completed"
                        domain="[('state', '=', 'done')]"/>

                <filter name="cancelled"
                        string="Cancelled"
                        domain="[('state', '=', 'cancelled')]"/>

                <filter name="active_task"
                        string="Active"
                        domain="[('state', 'not in', ['cancelled', 'done'])]"/>

                <separator/>

                <filter name="high_priority"
                        string="High Priority"
                        domain="[('priority', '=', '1')]"/>

                <filter name="today"
                        string="Today"
                        domain="[
                        ('scheduled_date', '>=', context_today()),
                        ('scheduled_date', '&lt;',
                         context_today() + relativedelta(days=1))
                    ]"/>

                <separator/>

                <group>

                    <filter name="group_room"
                            string="Room"
                            context="{'group_by': 'room_id'}"/>

                    <filter name="group_category"
                            string="Room Category"
                            context="{'group_by': 'room_category_id'}"/>

                    <filter name="group_type"
                            string="Cleaning Type"
                            context="{'group_by': 'housekeeping_type'}"/>

                    <filter name="group_assigned"
                            string="Assigned To"
                            context="{'group_by': 'assigned_to'}"/>

                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>

                </group>

            </search>

        </field>
    </record>

    <record id="action_hotel_housekeeping" model="ir.actions.act_window">

        <field name="name">Housekeeping</field>

        <field name="res_model">hotel.housekeeping</field>

        <field name="view_mode">kanban,list,form</field>

        <field name="view_id"
               ref="view_hotel_housekeeping_kanban"/>

        <field name="search_view_id"
               ref="view_hotel_housekeeping_search"/>

        <field name="context">
            {
            "search_default_active_task": 1
            }
        </field>

    </record>

</odoo>