<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hotel_guest_folio_list" model="ir.ui.view">
        <field name="name">hotel.guest.folio.list</field>
        <field name="model">hotel.guest.folio</field>
        <field name="arch" type="xml">

            <list string="Guest Folios">

                <field name="name"/>
                <field name="partner_id"/>
                <field name="reservation_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="total_amount"
                       sum="Total"/>
                <field name="paid_amount"
                       sum="Paid"/>
                <field name="balance_amount"
                       sum="Balance"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'open'"
                       decoration-warning="state == 'partially_paid'"
                       decoration-success="state == 'paid'"
                       decoration-muted="state == 'closed'"
                       decoration-danger="state == 'cancelled'"/>

            </list>

        </field>
    </record>

    <record id="view_hotel_guest_folio_form" model="ir.ui.view">
        <field name="name">hotel.guest.folio.form</field>
        <field name="model">hotel.guest.folio</field>
        <field name="arch" type="xml">

            <form string="Guest Folio">

                <header>

                    <button name="action_open"
                            string="Open"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_register_payment"
                            string="Register Payment"
                            type="object"
                            class="btn-primary"
                            invisible="state in ('closed', 'cancelled') or balance_amount &lt;= 0"/>

                    <button name="action_close"
                            string="Close Folio"
                            type="object"
                            class="btn-secondary"
                            invisible="state not in ('open', 'partially_paid', 'paid')"/>

                    <button name="action_create_invoice"
                            string="Create Invoice"
                            type="object"
                            class="btn-secondary"
                            invisible="invoice_id or state in ('closed', 'cancelled')"/>

                    <button name="action_send_folio_email"
                            string="Send by Email"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('draft', 'cancelled')"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('closed', 'cancelled')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,open,partially_paid,paid,closed"/>

                </header>

                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="receipt_long"
                                invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="invoice_amount"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                </span>
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>

                        <button name="action_view_agent_commission"
                                type="object"
                                class="oe_stat_button"
                                icon="handshake"
                                invisible="commission_count == 0">
                            <field name="commission_count"
                                   widget="statinfo"
                                   string="Commission"/>
                        </button>

                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>

                        <group string="Guest Information">

                            <field name="partner_id" readonly="state != 'draft'"/>

                            <field name="reservation_id" readonly="1"/>

                            <field name="room_booking_id" readonly="1" invisible="not room_booking_id"/>

                        </group>

                        <group string="Stay Details">

                            <field name="hotel_id" readonly="state != 'draft'"/>

                            <field name="check_in" readonly="state not in ('draft', 'open')"/>

                            <field name="check_out" readonly="state not in ('draft', 'open')"/>

                            <field name="company_id" invisible="1"/>

                            <field name="currency_id" invisible="1"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Room Charges" name="room_charges">

                            <field name="room_line_ids"
                                   context="{'default_charge_type': 'room', 'default_folio_id': id}"
                                   readonly="state in ('closed', 'cancelled')">

                                <list editable="bottom">

                                    <field name="date"/>
                                    <field name="description" string="Room / Description"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="quantity" string="Nights"/>
                                    <field name="unit_price" string="Rate / Night"/>
                                    <field name="discount" string="Disc. (%)"/>
                                    <field name="discount_amount" optional="show"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show"/>
                                    <field name="tax_amount" optional="show"/>
                                    <field name="amount_untaxed" string="Net Amount"/>
                                    <field name="total_amount" string="Total" sum="Total Room Charges"/>
                                    <field name="charge_type" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>

                                </list>

                            </field>

                        </page>

                        <page string="Service Charges" name="service_charges">

                            <field name="service_line_ids"
                                   context="{'default_charge_type': 'service', 'default_folio_id': id}"
                                   readonly="state in ('closed', 'cancelled')">

                                <list editable="bottom">

                                    <field name="date"/>
                                    <field name="description" string="Service"/>
                                    <field name="product_id"/>
                                    <field name="quantity" string="Quantity"/>
                                    <field name="unit_price" string="Unit Price"/>
                                    <field name="discount" string="Disc. (%)"/>
                                    <field name="discount_amount" optional="show"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show"/>
                                    <field name="tax_amount" optional="show"/>
                                    <field name="amount_untaxed" string="Net Amount"/>
                                    <field name="total_amount" string="Total" sum="Total Service Charges"/>
                                    <field name="charge_type" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>

                                </list>

                            </field>

                        </page>

                        <page string="Other Charges (Laundry, Spa, Dining)" name="other_charges">

                            <field name="other_line_ids"
                                   context="{'default_charge_type': 'other', 'default_folio_id': id}"
                                   readonly="state in ('closed', 'cancelled')">

                                <list editable="bottom">

                                    <field name="date"/>
                                    <field name="charge_type" string="Category"/>
                                    <field name="description"/>
                                    <field name="product_id"/>
                                    <field name="quantity" string="Qty"/>
                                    <field name="unit_price"/>
                                    <field name="discount" string="Disc. (%)"/>
                                    <field name="discount_amount" optional="show"/>
                                    <field name="tax_ids" widget="many2many_tags" optional="show"/>
                                    <field name="tax_amount" optional="show"/>
                                    <field name="amount_untaxed" string="Net Amount"/>
                                    <field name="total_amount" string="Total" sum="Total Other Charges"/>
                                    <field name="currency_id" column_invisible="1"/>

                                </list>

                            </field>

                        </page>

                        <page string="All Folio Charges" name="all_charges">

                            <field name="line_ids" readonly="1">

                                <list decoration-info="charge_type == 'room'"
                                      decoration-warning="charge_type == 'service'"
                                      decoration-muted="charge_type not in ('room', 'service')">

                                    <field name="date"/>
                                    <field name="charge_type" string="Type" widget="badge"/>
                                    <field name="description"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="discount" optional="show"/>
                                    <field name="discount_amount" optional="hide"/>
                                    <field name="tax_amount" optional="show"/>
                                    <field name="amount_untaxed" optional="show"/>
                                    <field name="total_amount" sum="Grand Total"/>
                                    <field name="currency_id" column_invisible="1"/>

                                </list>

                            </field>

                        </page>

                        <page string="Notes" name="notes">

                            <field name="notes"
                                   placeholder="Add internal notes for this folio..."/>

                        </page>

                    </notebook>

                    <group class="oe_subtotal_footer oe_right">

                        <field name="amount_untaxed"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>

                        <field name="discount_amount"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>

                        <field name="tax_amount"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>

                        <field name="total_amount"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               class="oe_subtotal_footer_separator fw-bold"/>

                        <field name="paid_amount"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>

                        <field name="balance_amount"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               class="oe_subtotal_footer_separator fw-bold text-danger"
                               invisible="balance_amount == 0"/>

                        <field name="balance_amount"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               class="oe_subtotal_footer_separator fw-bold text-success"
                               invisible="balance_amount &gt; 0"/>

                    </group>

                </sheet>

                <chatter/>

            </form>

        </field>
    </record>

    <record id="view_hotel_guest_folio_search" model="ir.ui.view">
        <field name="name">hotel.guest.folio.search</field>
        <field name="model">hotel.guest.folio</field>
        <field name="arch" type="xml">

            <search string="Guest Folios">

                <field name="name"/>
                <field name="partner_id"/>
                <field name="reservation_id"/>

                <separator/>

                <filter name="open"
                        string="Open"
                        domain="[('state', '=', 'open')]"/>

                <filter name="unpaid"
                        string="Outstanding"
                        domain="[('balance_amount', '>', 0)]"/>

                <filter name="paid"
                        string="Paid"
                        domain="[('state', '=', 'paid')]"/>

                <filter name="closed"
                        string="Closed"
                        domain="[('state', '=', 'closed')]"/>

                <group>

                    <filter name="group_guest"
                            string="Guest"
                            context="{'group_by': 'partner_id'}"/>

                    <filter name="group_status"
                            string="Status"
                            context="{'group_by': 'state'}"/>

                </group>

            </search>

        </field>
    </record>

    <record id="action_hotel_guest_folio" model="ir.actions.act_window">

        <field name="name">Guest Folios</field>

        <field name="res_model">hotel.guest.folio</field>

        <field name="view_mode">list,form</field>

        <field name="view_id"
               ref="view_hotel_guest_folio_list"/>

        <field name="search_view_id"
               ref="view_hotel_guest_folio_search"/>

            <field name="group_ids" eval="[(6, 0, [
            ref('vs_hotel_management.group_hotel_billing_user'),
            ref('vs_hotel_management.group_hotel_billing_manager'),
            ref('vs_hotel_management.group_hotel_reservation_user'),
            ref('vs_hotel_management.group_hotel_reservation_manager'),
            ref('vs_hotel_management.group_hotel_gm_user'),
            ref('vs_hotel_management.group_hotel_manager'),
            ref('vs_hotel_management.group_hotel_gm_bridge'),
            ref('vs_hotel_management.group_hotel_admin_user'),
            ref('vs_hotel_management.group_hotel_admin'),
            ref('vs_hotel_management.group_hotel_admin_bridge'),
        ])]"/>
    </record>
</odoo>