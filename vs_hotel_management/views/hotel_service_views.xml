<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Hotel Service List -->
    <record id="view_hotel_service_tree" model="ir.ui.view">
        <field name="name">product.template.hotel.service.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Hotel Services" default_order="name">

                <field name="image_128"
                       widget="image"
                       options="{'size': [40, 40]}"/>

                <field name="name"/>
                <field name="categ_id"/>
                <field name="list_price" widget="monetary"/>

                <field name="is_complimentary"
                       widget="boolean_toggle"
                       string="Complimentary"/>

            </list>
        </field>
    </record>


    <!-- Hotel Service Search -->
    <record id="view_hotel_service_search" model="ir.ui.view">
        <field name="name">product.template.hotel.service.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">

            <search string="Search Hotel Service">

                <field name="name"/>
                <field name="categ_id"/>
                <field name="hotel_id"/>

                <separator/>

                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />

                <filter
                    name="complimentary"
                    string="Complimentary"
                    domain="[('is_complimentary', '=', True)]"
                />

                <filter
                    name="paid"
                    string="Paid"
                    domain="[('is_complimentary', '=', False)]"
                />

                <group expand="0" string="Group By">

                    <filter
                        name="category"
                        string="Category"
                        context="{'group_by': 'categ_id'}"
                    />

                    <filter
                        name="hotel"
                        string="Hotel"
                        context="{'group_by': 'hotel_id'}"
                    />

                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"
                    />

                </group>

            </search>

        </field>
    </record>


    <!-- Hotel Service Form -->
    <record id="view_product_template_hotel_service_form" model="ir.ui.view">
        <field name="name">product.template.hotel.service.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='type']" position="after">

                <field name="is_hotel_service"/>
                <field name="is_complimentary"/>
                <field name="hotel_id"/>

            </xpath>

        </field>
    </record>


    <!-- Hotel Service Kanban -->
    <record id="view_hotel_service_kanban" model="ir.ui.view">
        <field name="name">product.template.hotel.service.kanban</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">

            <kanban class="o_kanban_mobile">

                <field name="image_128"/>
                <field name="name"/>
                <field name="categ_id"/>
                <field name="list_price"/>
                <field name="is_complimentary"/>
                <field name="active"/>

                <templates>

                    <t t-name="card">

                        <div class="oe_kanban_global_click border rounded bg-white p-3">

                            <!-- Service Image -->
                            <div class="d-flex justify-content-center align-items-center mb-2">

                                <field
                                    name="image_128"
                                    widget="image"
                                    class="rounded"
                                    style="width:54px;height:54px;"
                                />

                            </div>

                            <!-- Name & Category -->
                            <div class="text-center">

                                <span class="fw-bold">
                                    <field name="name"/>
                                </span>

                                <span class="text-muted mx-1">
                                    •
                                </span>

                                <span class="text-muted">
                                    <field name="categ_id"/>
                                </span>

                            </div>

                            <!-- Price / Complimentary -->
                            <div class="text-center mt-2">

                                <t t-if="record.is_complimentary.raw_value">

                                    <span class="badge text-bg-success">
                                        Complimentary
                                    </span>

                                </t>

                                <t t-else="">

                                    <span class="fw-bold text-primary">
                                        <field name="list_price"/>
                                    </span>

                                </t>

                            </div>

                        </div>

                    </t>

                </templates>

            </kanban>

        </field>
    </record>


    <!-- Hotel Services Action -->
    <record id="action_hotel_service" model="ir.actions.act_window">

        <field name="name">Hotel Services</field>

        <field name="res_model">product.template</field>

        <field name="view_mode">kanban,list,form</field>

        <field name="domain">
            [
                ('is_hotel_service', '=', True),
                ('sale_ok', '=', True),
                ('type', '=', 'service')
            ]
        </field>

        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'view_mode': 'kanban',
                'view_id': ref('view_hotel_service_kanban')
            }),
            (0, 0, {
                'view_mode': 'list',
                'view_id': ref('view_hotel_service_tree')
            })
        ]"/>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Hotel Service
            </p>
        </field>

    </record>

</odoo>