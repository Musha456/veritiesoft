<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_hotel_whatsapp_log_list" model="ir.ui.view">
        <field name="name">hotel.whatsapp.log.list</field>
        <field name="model">hotel.whatsapp.log</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Notifications"
                  create="0" edit="0" delete="0"
                  decoration-success="status in ('sent', 'delivered', 'read')"
                  decoration-danger="status == 'failed'"
                  decoration-warning="status == 'queued'"
                  decoration-muted="status == 'draft'">
                <header>
                    <button name="cron_process_whatsapp_queue"
                            type="object"
                            string="Process Queue Now"
                            class="btn-secondary"
                            icon="fa-paper-plane"/>
                </header>
                <field name="name"/>
                <field name="create_date" string="Created"/>
                <field name="recipient_id"/>
                <field name="phone_number"/>
                <field name="task_type"/>
                <field name="event"/>
                <field name="task_reference"/>
                <field name="status" widget="badge"
                       decoration-success="status in ('sent', 'delivered', 'read')"
                       decoration-danger="status == 'failed'"
                       decoration-warning="status == 'queued'"
                       decoration-muted="status == 'draft'"/>
                <field name="sent_at" optional="show"/>
                <field name="meta_message_id" optional="hide"/>
                <button name="action_resend"
                        type="object"
                        string="Send / Resend"
                        class="btn-sm btn-link text-primary"
                        icon="fa-paper-plane"
                        title="Send or Resend WhatsApp Message"
                        invisible="status not in ('draft', 'failed', 'queued')"/>
                <button name="action_set_to_draft"
                        type="object"
                        string="Draft"
                        class="btn-sm btn-link text-muted"
                        icon="fa-undo"
                        title="Set to Draft"
                        invisible="status != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_whatsapp_log_form" model="ir.ui.view">
        <field name="name">hotel.whatsapp.log.form</field>
        <field name="model">hotel.whatsapp.log</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Notification" create="0">
                <header>
                    <button name="action_resend"
                            type="object"
                            string="Send / Resend WhatsApp"
                            class="btn-primary"
                            icon="fa-paper-plane"
                            invisible="status not in ('draft', 'failed', 'queued')"/>
                    <button name="action_set_to_draft"
                            type="object"
                            string="Set to Draft"
                            class="btn-secondary"
                            icon="fa-undo"
                            invisible="status != 'failed'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,queued,sent,delivered,read,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Recipient Information">
                            <field name="recipient_id" readonly="status not in ('draft', 'failed')"/>
                            <field name="phone_number" readonly="status not in ('draft', 'failed')" placeholder="e.g. 15551234567"/>
                            <field name="company_id" readonly="1"/>
                            <field name="task_reference" readonly="1"/>
                            <field name="task_type" readonly="1"/>
                            <field name="event" readonly="1"/>
                        </group>
                        <group string="Delivery Information">
                            <field name="meta_message_id"/>
                            <field name="create_date" string="Created On"/>
                            <field name="sent_at"/>
                            <field name="delivered_at"/>
                            <field name="read_at"/>
                        </group>
                    </group>
                    <group string="Message Content">
                        <field name="message" nolabel="1" readonly="status not in ('draft', 'failed')" placeholder="Enter WhatsApp message text..."/>
                    </group>
                    <group string="Failure Reason" invisible="not error_details">
                        <field name="error_details" nolabel="1" readonly="1" class="text-danger"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hotel_whatsapp_log_search" model="ir.ui.view">
        <field name="name">hotel.whatsapp.log.search</field>
        <field name="model">hotel.whatsapp.log</field>
        <field name="arch" type="xml">
            <search string="Search WhatsApp Notifications">
                <field name="name"/>
                <field name="phone_number"/>
                <field name="recipient_id"/>
                <field name="meta_message_id"/>
                <separator/>
                <filter string="Failed" name="filter_failed" domain="[('status', '=', 'failed')]"/>
                <filter string="Draft" name="filter_draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Queued" name="filter_queued" domain="[('status', '=', 'queued')]"/>
                <filter string="Sent / Delivered" name="filter_sent" domain="[('status', 'in', ('sent', 'delivered', 'read'))]"/>
                <separator/>
                <filter string="Reservation" name="filter_res" domain="[('task_type', '=', 'reservation')]"/>
                <filter string="Housekeeping" name="filter_hk" domain="[('task_type', '=', 'housekeeping')]"/>
                <filter string="Maintenance" name="filter_maint" domain="[('task_type', '=', 'maintenance')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Module / Type" name="group_task_type" context="{'group_by': 'task_type'}"/>
                    <filter string="Event" name="group_event" context="{'group_by': 'event'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Creation Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_whatsapp_log" model="ir.actions.act_window">
        <field name="name">WhatsApp Notifications</field>
        <field name="res_model">hotel.whatsapp.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hotel_whatsapp_log_search"/>
        <field name="context">{'search_default_filter_failed': 0}</field>
    </record>

</odoo>
