<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_hotel_building_tree" model="ir.ui.view">
        <field name="name">hotel.building.tree</field>
        <field name="model">hotel.building</field>
        <field name="arch" type="xml">
            <list default_order="sequence,name">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="hotel_id"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_building_search" model="ir.ui.view">
        <field name="name">hotel.building.search</field>
        <field name="model">hotel.building</field>
        <field name="arch" type="xml">
            <search string="Search Buildings">

                <field name="name"/>
                <field name="code"/>
                <field name="hotel_id"/>
                <field name="company_id"/>

                <separator/>

                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <filter name="hotel_id" string="Hotel" context="{'group_by':'hotel_id'}"/>
                </group>

            </search>
        </field>
    </record>


    <record id="view_hotel_building_form" model="ir.ui.view">
        <field name="name">hotel.building.form</field>
        <field name="model">hotel.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <header>

                    <button name="action_set_maintenance"
                            type="object"
                            string="Send to Maintenance"
                            class="btn-warning"
                            invisible="status != 'operational'"/>

                    <button name="action_set_closed"
                            type="object"
                            string="Close Building"
                            class="btn-danger"
                            invisible="status == 'closed'"/>

                    <button name="action_set_operational"
                            type="object"
                            string="Reopen Building"
                            class="btn-primary"
                            invisible="status != 'closed' and status != 'maintenance'"/>

                </header>
                <sheet>

                    <widget name="web_ribbon"
                            title="Operational"
                            bg_color="bg-success"
                            invisible="status != 'operational'"/>

                    <widget name="web_ribbon"
                            title="Maintenance"
                            bg_color="bg-warning"
                            invisible="status != 'maintenance'"/>

                    <widget name="web_ribbon"
                            title="Closed"
                            bg_color="bg-danger"
                            invisible="status != 'closed'"/>

                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_floors"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-list-alt"
                                invisible="not floor_count">

                            <field name="floor_count"
                                   widget="statinfo"
                                   string="Floors"/>

                        </button>

                        <button name="action_view_rooms"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-bed"
                                invisible="not room_count">

                            <field name="room_count"
                                   widget="statinfo"
                                   string="Rooms"/>

                        </button>

                    </div>

                    <!-- Title -->
                    <div class="oe_title">

                        <label for="name"/>

                        <h1>

                            <field name="name"
                                   placeholder="e.g. Main Building"/>

                        </h1>

                        <div class="text-muted mt-1">

                            <strong class="me-1">Code:</strong>

                            <field name="code"
                                   class="oe_inline"
                                   readonly="1"/>

                        </div>

                    </div>

                    <!-- Top Information -->
                    <group col="3">

                        <!-- General -->
                        <group string="General Information" colspan="2">

                            <group>
                                <field name="hotel_id"/>

                                <field name="building_type"/>
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="manager_id" widget="many2one_avatar"/>

                                <field name="active" widget="boolean_toggle"/>
                            </group>


                        </group>

                        <!-- Image -->
                        <group string="Building Image" colspan="1">

                            <field name="image"
                                   widget="image"
                                   nolabel="1"
                                   options="{'size':[420,240]}"/>

                        </group>

                    </group>

                    <notebook>

                        <!-- Description -->
                        <page string="Description">

                            <field name="description"
                                   widget="html"
                                   nolabel="1"
                                   placeholder="Describe this building, its purpose, facilities, and any important operational notes."/>

                        </page>

                        <!-- Location -->
                        <page string="Location">

                            <group col="2">

                                <group string="Address">

                                    <field name="street"
                                           placeholder="Street"/>

                                    <field name="street2"
                                           placeholder="Street 2"/>

                                    <field name="city"/>

                                    <field name="state_id"/>

                                    <field name="zip"/>

                                    <field name="country_id"/>

                                </group>

                                <group string="Map Coordinates">

                                    <field name="latitude"/>

                                    <field name="longitude"/>

                                </group>

                            </group>

                        </page>

                        <!-- Floors -->
                        <page string="Floors">

                            <field name="floor_ids"
                                   mode="list,kanban"
                                   nolabel="1">

                                <list>

                                    <field name="sequence"
                                           widget="handle"/>

                                    <field name="name"/>

                                    <field name="code"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <record id="action_hotel_building" model="ir.actions.act_window">

        <field name="name">Buildings</field>

        <field name="res_model">hotel.building</field>

        <field name="view_mode">list,form</field>

        <field name="search_view_id" ref="view_hotel_building_search"/>

        <field name="help" type="html">

            <p class="o_view_nocontent_smiling_face">
                Create your first hotel building.
            </p>

            <p>
                Hotel buildings help organize your property into separate buildings,
                towers, wings, or blocks. Buildings can contain multiple floors and
                rooms, making it easier to manage large hotels and support
                multi-building properties.
            </p>

        </field>

    </record>

</odoo>