<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_company_form_hotel_whatsapp" model="ir.ui.view">
        <field name="name">res.company.form.hotel.whatsapp</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="WhatsApp Configuration" name="whatsapp_config" groups="base.group_system">
                    <div class="alert alert-info d-flex align-items-center mb-3" role="status">
                        <i class="fa fa-info-circle fa-2x me-3"/>
                        <div>
                            <strong>Meta WhatsApp Cloud API Configuration</strong><br/>
                            Configure Meta WhatsApp Cloud API credentials for <strong><field name="name" readonly="1" class="oe_inline"/></strong>.
                            These company-specific credentials enable automated notifications for reservations, guest checkouts, and staff task assignments.
                        </div>
                    </div>
                    <group>
                        <group string="Meta Cloud API Credentials">
                            <field name="whatsapp_access_token" password="True" placeholder="EAAB..."/>
                            <field name="whatsapp_phone_number_id" placeholder="e.g. 106543210987654"/>
                            <field name="whatsapp_business_account_id" placeholder="e.g. 109876543210987"/>
                            <field name="whatsapp_api_version" placeholder="v23.0"/>
                        </group>
                        <group string="Template &amp; Language Settings">
                            <field name="whatsapp_template_name"/>
                            <field name="whatsapp_template_language"/>
                            <field name="whatsapp_webhook_verify_token"/>
                        </group>
                    </group>
                    <div class="mt-3">
                        <button name="action_test_whatsapp_connection"
                                type="object"
                                string="Test Connection"
                                class="btn-primary"
                                icon="link"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
