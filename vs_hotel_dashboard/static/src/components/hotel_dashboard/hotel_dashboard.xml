<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vs_hotel_dashboard.HotelDashboard">
        <div class="o_hotel_dashboard p-3 p-md-4 overflow-auto">
            
            <!-- =========================================================
                 1. TOP HEADER & FILTER BAR
            ========================================================== -->
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 bg-white p-3 rounded-3 shadow-sm border">
                <div class="d-flex align-items-center gap-2">
                    <div class="o_hotel_icon_badge d-flex align-items-center justify-content-center rounded-3 bg-primary text-white shadow-sm">
                        <i class="fa fa-hotel fa-lg"/>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold text-dark">Hotel Operations Command Center</h4>
                        <small class="text-muted">Real-time hospitality analytics, operational queues &amp; revenue KPIs</small>
                    </div>
                </div>

                <!-- Filters -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <!-- Hotel Selector -->
                    <select class="form-select form-select-sm w-auto shadow-sm fw-semibold"
                            t-on-change="this.onHotelChange"
                            t-att-value="this.state.selectedHotelId">
                        <t t-foreach="this.state.hotels" t-as="h" t-key="h.id">
                            <option t-att-value="h.id" t-esc="h.name"/>
                        </t>
                    </select>

                    <!-- Preset Button Group -->
                    <div class="btn-group btn-group-sm shadow-sm" role="group">
                        <button type="button" class="btn"
                                t-att-class="this.state.selectedPreset === 'today' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.onPresetChange('today')">
                            Today
                        </button>
                        <button type="button" class="btn"
                                t-att-class="this.state.selectedPreset === 'this_week' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.onPresetChange('this_week')">
                            This Week
                        </button>
                        <button type="button" class="btn"
                                t-att-class="this.state.selectedPreset === 'this_month' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.onPresetChange('this_month')">
                            This Month
                        </button>
                        <button type="button" class="btn"
                                t-att-class="this.state.selectedPreset === 'last_30_days' ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.onPresetChange('last_30_days')">
                            30 Days
                        </button>
                    </div>

                    <!-- Live Refresh Button -->
                    <button class="btn btn-sm btn-outline-primary shadow-sm"
                            t-on-click="this.reload"
                            title="Refresh Data">
                        <i class="fa fa-refresh" t-att-class="{'fa-spin': this.state.isLoading}"/>
                    </button>
                </div>
            </div>

            <!-- Loading Spinner -->
            <t t-if="this.state.isLoading">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading Dashboard...</span>
                    </div>
                    <div class="mt-2 text-muted fw-semibold">Loading real-time hotel metrics...</div>
                </div>
            </t>

            <t t-else="">
                <!-- =========================================================
                     2. EXECUTIVE HOSPITALITY KPIS (Top Cards)
                ========================================================== -->
                <div class="row g-3 mb-4">
                    <!-- Occupancy Rate -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card o_card_occupancy">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small text-uppercase fw-bold">Occupancy Rate</span>
                                    <div class="o_kpi_icon bg-primary-subtle text-primary rounded-circle">
                                        <i class="fa fa-pie-chart"/>
                                    </div>
                                </div>
                                <div class="d-flex align-items-baseline gap-2 mb-2">
                                    <h2 class="mb-0 fw-bold"><t t-esc="this.state.kpis.occupancy_rate"/>%</h2>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" role="progressbar"
                                         t-att-style="'width: ' + this.state.kpis.occupancy_rate + '%'"/>
                                </div>
                                <div class="d-flex justify-content-between mt-2 small text-muted">
                                    <span><b class="text-dark"><t t-esc="this.state.kpis.occupied_rooms"/></b> Occupied</span>
                                    <span><b class="text-dark"><t t-esc="this.state.kpis.total_operational_rooms"/></b> Total</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ADR (Average Daily Rate) -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card o_card_adr">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small text-uppercase fw-bold">Average Daily Rate (ADR)</span>
                                    <div class="o_kpi_icon bg-success-subtle text-success rounded-circle">
                                        <i class="fa fa-tags"/>
                                    </div>
                                </div>
                                <div class="d-flex align-items-baseline gap-1 mb-2">
                                    <span class="fs-5 text-muted"><t t-esc="this.state.currencySymbol"/></span>
                                    <h2 class="mb-0 fw-bold"><t t-esc="this.state.kpis.adr"/></h2>
                                </div>
                                <small class="text-muted">Per occupied room night</small>
                            </div>
                        </div>
                    </div>

                    <!-- RevPAR -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card o_card_revpar">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small text-uppercase fw-bold">RevPAR</span>
                                    <div class="o_kpi_icon bg-purple-subtle text-purple rounded-circle">
                                        <i class="fa fa-line-chart"/>
                                    </div>
                                </div>
                                <div class="d-flex align-items-baseline gap-1 mb-2">
                                    <span class="fs-5 text-muted"><t t-esc="this.state.currencySymbol"/></span>
                                    <h2 class="mb-0 fw-bold"><t t-esc="this.state.kpis.revpar"/></h2>
                                </div>
                                <small class="text-muted">Revenue per available room</small>
                            </div>
                        </div>
                    </div>

                    <!-- Total Period Revenue -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card o_card_revenue">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small text-uppercase fw-bold">Total Revenue</span>
                                    <div class="o_kpi_icon bg-warning-subtle text-warning rounded-circle">
                                        <i class="fa fa-money"/>
                                    </div>
                                </div>
                                <div class="d-flex align-items-baseline gap-1 mb-2">
                                    <span class="fs-5 text-muted"><t t-esc="this.state.currencySymbol"/></span>
                                    <h2 class="mb-0 fw-bold"><t t-esc="this.state.kpis.total_revenue"/></h2>
                                </div>
                                <small class="text-muted">Rooms: <t t-esc="this.state.currencySymbol"/><t t-esc="this.state.kpis.room_revenue"/></small>
                            </div>
                        </div>
                    </div>

                    <!-- Uncollected Folio Balance -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="card h-100 border-0 shadow-sm o_kpi_card o_card_balance cursor-pointer"
                             t-on-click="this.openPendingFolios"
                             title="Click to view open folios">
                            <div class="card-body">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-muted small text-uppercase fw-bold">Pending Folio Balance</span>
                                    <div class="o_kpi_icon bg-danger-subtle text-danger rounded-circle">
                                        <i class="fa fa-credit-card"/>
                                    </div>
                                </div>
                                <div class="d-flex align-items-baseline gap-1 mb-2">
                                    <span class="fs-5 text-danger"><t t-esc="this.state.currencySymbol"/></span>
                                    <h2 class="mb-0 fw-bold text-danger"><t t-esc="this.state.kpis.pending_folio_balance"/></h2>
                                </div>
                                <small class="text-danger fw-semibold">Click to review open folios &#8594;</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================================================
                     3. FRONT DESK OPERATIONAL QUEUES (Action Cards)
                ========================================================== -->
                <div class="row g-3 mb-4">
                    <!-- Expected Arrivals Today -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm o_action_card cursor-pointer"
                             t-on-click="this.openArrivalsToday">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="o_action_avatar bg-primary text-white rounded-3 shadow-sm">
                                    <i class="fa fa-sign-in fa-lg"/>
                                </div>
                                <div>
                                    <h3 class="mb-0 fw-bold"><t t-esc="this.state.queues.arrivals_today"/></h3>
                                    <div class="text-muted small fw-semibold">Expected Arrivals Today</div>
                                </div>
                                <i class="fa fa-arrow-right text-muted ms-auto"/>
                            </div>
                        </div>
                    </div>

                    <!-- Expected Departures Today -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm o_action_card cursor-pointer"
                             t-on-click="this.openDeparturesToday">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="o_action_avatar bg-warning text-white rounded-3 shadow-sm">
                                    <i class="fa fa-sign-out fa-lg"/>
                                </div>
                                <div>
                                    <h3 class="mb-0 fw-bold"><t t-esc="this.state.queues.departures_today"/></h3>
                                    <div class="text-muted small fw-semibold">Expected Departures Today</div>
                                </div>
                                <i class="fa fa-arrow-right text-muted ms-auto"/>
                            </div>
                        </div>
                    </div>

                    <!-- In-House Guests -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm o_action_card cursor-pointer"
                             t-on-click="this.openInHouse">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="o_action_avatar bg-success text-white rounded-3 shadow-sm">
                                    <i class="fa fa-users fa-lg"/>
                                </div>
                                <div>
                                    <h3 class="mb-0 fw-bold"><t t-esc="this.state.queues.in_house"/></h3>
                                    <div class="text-muted small fw-semibold">In-House Active Stays</div>
                                </div>
                                <i class="fa fa-arrow-right text-muted ms-auto"/>
                            </div>
                        </div>
                    </div>

                    <!-- Overstay Alerts -->
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card border-0 shadow-sm o_action_card cursor-pointer"
                             t-on-click="this.openOverstays"
                             t-att-class="this.state.queues.overstay > 0 ? 'border-danger border-2' : ''">
                            <div class="card-body d-flex align-items-center gap-3">
                                <div class="o_action_avatar bg-danger text-white rounded-3 shadow-sm">
                                    <i class="fa fa-exclamation-triangle fa-lg"/>
                                </div>
                                <div>
                                    <h3 class="mb-0 fw-bold text-danger"><t t-esc="this.state.queues.overstay"/></h3>
                                    <div class="text-muted small fw-semibold">Overstay Alerts</div>
                                </div>
                                <i class="fa fa-arrow-right text-muted ms-auto"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================================================
                     4. HOUSEKEEPING & ROOM INVENTORY STATUS (Badges Grid)
                ========================================================== -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <i class="fa fa-bed text-primary fs-5"/>
                                <h6 class="mb-0 fw-bold">Room Operations &amp; Housekeeping Status</h6>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="this.openHousekeepingTasks">
                                    <i class="fa fa-tasks me-1"/> Active HK Tasks (<t t-esc="this.state.housekeeping.active_tasks"/>)
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="this.openMaintenanceTasks">
                                    <i class="fa fa-wrench me-1"/> Maintenance (<t t-esc="this.state.housekeeping.active_maintenance"/>)
                                </button>
                            </div>
                        </div>

                        <div class="row g-2 text-center">
                            <!-- Clean & Available -->
                            <div class="col cursor-pointer" t-on-click="() => this.openRoomsByStatus('available')">
                                <div class="p-2 rounded bg-success-subtle border border-success-subtle">
                                    <div class="fs-4 fw-bold text-success"><t t-esc="this.state.housekeeping.clean"/></div>
                                    <small class="text-success-emphasis fw-semibold">Available &amp; Clean</small>
                                </div>
                            </div>
                            <!-- Occupied -->
                            <div class="col cursor-pointer" t-on-click="() => this.openRoomsByStatus('occupied')">
                                <div class="p-2 rounded bg-primary-subtle border border-primary-subtle">
                                    <div class="fs-4 fw-bold text-primary"><t t-esc="this.state.kpis.occupied_rooms"/></div>
                                    <small class="text-primary-emphasis fw-semibold">Occupied</small>
                                </div>
                            </div>
                            <!-- Dirty -->
                            <div class="col cursor-pointer" t-on-click="() => this.openRoomsByStatus('dirty')">
                                <div class="p-2 rounded bg-danger-subtle border border-danger-subtle">
                                    <div class="fs-4 fw-bold text-danger"><t t-esc="this.state.housekeeping.dirty"/></div>
                                    <small class="text-danger-emphasis fw-semibold">Dirty (Need Clean)</small>
                                </div>
                            </div>
                            <!-- Cleaning in Progress -->
                            <div class="col cursor-pointer" t-on-click="() => this.openRoomsByStatus('cleaning')">
                                <div class="p-2 rounded bg-purple-subtle border border-purple-subtle">
                                    <div class="fs-4 fw-bold text-purple"><t t-esc="this.state.housekeeping.cleaning"/></div>
                                    <small class="text-purple-emphasis fw-semibold">Cleaning</small>
                                </div>
                            </div>
                            <!-- Maintenance -->
                            <div class="col cursor-pointer" t-on-click="() => this.openRoomsByStatus('maintenance')">
                                <div class="p-2 rounded bg-warning-subtle border border-warning-subtle">
                                    <div class="fs-4 fw-bold text-warning-emphasis"><t t-esc="this.state.housekeeping.maintenance"/></div>
                                    <small class="text-warning-emphasis fw-semibold">Maintenance</small>
                                </div>
                            </div>
                            <!-- Out of Order -->
                            <div class="col cursor-pointer" t-on-click="() => this.openRoomsByStatus('out_of_order')">
                                <div class="p-2 rounded bg-secondary-subtle border border-secondary-subtle">
                                    <div class="fs-4 fw-bold text-secondary"><t t-esc="this.state.housekeeping.out_of_order"/></div>
                                    <small class="text-secondary fw-semibold">Out of Order</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================================================
                     5. VISUAL ANALYTICS & CHARTS GRID
                ========================================================== -->
                <div class="row g-3 mb-4">
                    <!-- 7-Day Trend Chart -->
                    <div class="col-12 col-lg-8">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-3 pb-0">
                                <div class="d-flex align-items-center justify-content-between">
                                    <h6 class="mb-0 fw-bold">7-Day Occupancy &amp; Revenue Velocity</h6>
                                    <small class="text-muted">Bar: Occupied Rooms | Line: Revenue</small>
                                </div>
                            </div>
                            <div class="card-body" style="height: 320px;">
                                <canvas t-ref="this.trendChartRef"/>
                            </div>
                        </div>
                    </div>

                    <!-- Booking Sources Donut -->
                    <div class="col-12 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-3 pb-0">
                                <h6 class="mb-0 fw-bold">Booking Source Distribution</h6>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center" style="height: 320px;">
                                <canvas t-ref="this.sourceChartRef"/>
                            </div>
                        </div>
                    </div>

                    <!-- Department Revenue Bar Chart -->
                    <div class="col-12 col-lg-8">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-3 pb-0">
                                <h6 class="mb-0 fw-bold">Revenue by Department &amp; Charge Type</h6>
                            </div>
                            <div class="card-body" style="height: 280px;">
                                <canvas t-ref="this.revenueChartRef"/>
                            </div>
                        </div>
                    </div>

                    <!-- Room Status Donut Chart -->
                    <div class="col-12 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-3 pb-0">
                                <h6 class="mb-0 fw-bold">Room Inventory Status</h6>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center" style="height: 280px;">
                                <canvas t-ref="this.roomStatusChartRef"/>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- =========================================================
                     6. LIVE OPERATIONAL FEEDS (Arrivals & Departures)
                ========================================================== -->
                <div class="row g-3">
                    <!-- Upcoming Arrivals -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold text-primary">
                                    <i class="fa fa-sign-in me-1"/> Next Upcoming Arrivals
                                </h6>
                                <button class="btn btn-sm btn-link text-decoration-none p-0" t-on-click="this.openArrivalsToday">
                                    View All &#8594;
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="this.state.upcomingArrivals.length === 0">
                                    <div class="text-center py-4 text-muted small">No upcoming arrivals pending.</div>
                                </t>
                                <t t-else="">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="this.state.upcomingArrivals" t-as="item" t-key="item.id">
                                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 cursor-pointer"
                                                 t-on-click="() => this.openReservation(item.id)">
                                                <div>
                                                    <div class="fw-bold text-dark"><t t-esc="item.guest"/></div>
                                                    <small class="text-muted">
                                                        <span class="badge bg-light text-dark border me-1"><t t-esc="item.name"/></span>
                                                        Room: <b class="text-dark"><t t-esc="item.rooms"/></b>
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <div class="small fw-semibold text-primary"><t t-esc="item.check_in"/></div>
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><t t-esc="item.state"/></span>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Expected Departures -->
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold text-warning-emphasis">
                                    <i class="fa fa-sign-out me-1"/> Today's Expected Departures
                                </h6>
                                <button class="btn btn-sm btn-link text-decoration-none p-0" t-on-click="this.openDeparturesToday">
                                    View All &#8594;
                                </button>
                            </div>
                            <div class="card-body p-0">
                                <t t-if="this.state.upcomingDepartures.length === 0">
                                    <div class="text-center py-4 text-muted small">No departures scheduled for today.</div>
                                </t>
                                <t t-else="">
                                    <div class="list-group list-group-flush">
                                        <t t-foreach="this.state.upcomingDepartures" t-as="item" t-key="item.id">
                                            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 cursor-pointer"
                                                 t-on-click="() => this.openReservation(item.id)">
                                                <div>
                                                    <div class="fw-bold text-dark"><t t-esc="item.guest"/></div>
                                                    <small class="text-muted">
                                                        <span class="badge bg-light text-dark border me-1"><t t-esc="item.name"/></span>
                                                        Room: <b class="text-dark"><t t-esc="item.rooms"/></b>
                                                    </small>
                                                </div>
                                                <div class="text-end">
                                                    <div class="small fw-semibold text-muted"><t t-esc="item.check_out"/></div>
                                                    <div class="small text-danger fw-bold">
                                                        Bal: <t t-esc="this.state.currencySymbol"/><t t-esc="item.balance"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </div>
    </t>
</templates>
